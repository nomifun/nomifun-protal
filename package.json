{
  "name": "nomifun-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/sync-releases.mjs",
    "build": "next build",
    "build:vercel": "npm run build && node scripts/package-vercel.mjs",
    "start": "next start",
    "preview": "node scripts/serve-static.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:work-motion": "node scripts/check-work-motion.mjs",
    "sync:releases": "node scripts/sync-releases.mjs",
    "check:downloads": "node scripts/check-downloads.mjs && node scripts/check-download-selection.mjs && node scripts/check-download-catalog.mjs && node scripts/check-release-history.mjs",
    "check:release-service": "node scripts/check-release-service.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.1.14",
    "marked": "^18.0.14",
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "description": "NomiFun official product portal"
}
