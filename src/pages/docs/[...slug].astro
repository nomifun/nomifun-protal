---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { render } from 'astro:content';
import { localizePath } from '@/i18n';
import { getDocsForLocale, topicSlug } from '@/lib/docs';

export async function getStaticPaths() {
  const docs = await getDocsForLocale('zh-CN');
  return docs.map((entry, i) => ({
    params: { slug: topicSlug(entry.id) },
    props: {
      entry,
      prev: i > 0 ? docs[i - 1] : null,
      next: i < docs.length - 1 ? docs[i + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const prevSlug = prev ? topicSlug(prev.id) : null;
const nextSlug = next ? topicSlug(next.id) : null;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  activeSlug={topicSlug(entry.id)}
  eyebrow={entry.data.category}
  heading={entry.data.title}
>
  <Content />

  <nav slot="after" class="mt-14 grid gap-4 border-t border-ink-700 pt-8 sm:grid-cols-2">
    {prev ? (
      <a href={localizePath(`/docs/${prevSlug}`, 'zh-CN')} class="card card-hover p-4 flex flex-col gap-1 group">
        <span class="text-xs text-low inline-flex items-center gap-1"><span class="i-mdi-arrow-left"></span>上一篇</span>
        <span class="text-sm font-medium text-hi group-hover:text-pink-300 transition-colors">{prev.data.title}</span>
      </a>
    ) : (
      <span></span>
    )}
    {next ? (
      <a href={localizePath(`/docs/${nextSlug}`, 'zh-CN')} class="card card-hover p-4 flex flex-col gap-1 items-end text-right group">
        <span class="text-xs text-low inline-flex items-center gap-1">下一篇<span class="i-mdi-arrow-right"></span></span>
        <span class="text-sm font-medium text-hi group-hover:text-pink-300 transition-colors">{next.data.title}</span>
      </a>
    ) : (
      <span></span>
    )}
  </nav>
</DocsLayout>
