---
/**
 * Other projects — the NomiFun open-source family first, followed by a
 * smaller friendly-picks section. The /friends route is kept for backwards
 * compatibility with existing links.
 */
import { ecosystemRepos, links } from '@/data/links';
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';

const locale: Locale = getLocale(Astro.url);

interface ProductCopy {
  tagline: string;
  category: string;
  desc: string;
  tags: string[];
}

const PRODUCTS = [
  { id: 'saytive', name: 'Saytive', url: 'https://saytive.app', domain: 'saytive.app', icon: 'i-mdi-microphone-message', accent: 'pink' as const },
  { id: 'fast', name: 'Fast', url: 'https://fast.saien.pro', domain: 'fast.saien.pro', icon: 'i-mdi-magnify-expand', accent: 'violet' as const },
  { id: 'aionui', name: 'AionUi', url: links.aionui, domain: 'github.com/iOfficeAI/AionUi', icon: 'i-mdi-robot-happy-outline', accent: 'cyan' as const },
];

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  familyTitle: string;
  familyEyebrow: string;
  familyLead: string;
  repoVisit: string;
  giteeVisit: string;
  repos: Record<string, { tagline: string; desc: string; tags: string[] }>;
  friendsEyebrow: string;
  friendsTitle: string;
  friendsLead: string;
  visit: string;
  products: Record<string, ProductCopy>;
  bottomTitle: string;
  bottomBody: string;
  bottomCta: string;
}> = {
  'zh-CN': {
    eyebrow: '其他项目',
    title: '从 NomiFun 开源生态，<span class="text-grad-pink">一起把想法做成现实</span>',
    lead: '这里集中展示 NomiFun 的开源项目家族，也保留我们真心喜欢的友情推荐。项目从自用与内容朋友的小范围使用开始，保持实验性、公益性与克制的开放节奏。',
    familyTitle: 'NomiFun 开源生态家族',
    familyEyebrow: '开源生态家族',
    familyLead: '一套本地优先的 Agent Desktop 底座，连接桌面、移动端、硬件伙伴与自托管网络中继。所有仓库都欢迎阅读、二次开发与共建。',
    repoVisit: '查看 GitHub 仓库',
    giteeVisit: '访问 Gitee 镜像',
    repos: {
      desktop: {
        tagline: '跨平台 Agent Desktop 主工作台',
        desc: 'NomiFun 的核心桌面应用。开源、免费、无商业化限制，支持 Windows、macOS 与 Linux；多模型、多 Agent、终端、WebUI 远程控制、知识库、自动化与本地伙伴能力都在这里汇聚。',
        tags: ['Windows · macOS · Linux', 'Apache-2.0', '本地就是服务器'],
      },
      mobile: {
        tagline: '手机直连 Desktop 的移动端生态',
        desc: '面向移动场景的轻量入口：优先在局域网中直连自己的 Desktop；需要跨网络时，也可按部署选择端到端加密的中继路径。适合随时查看会话、发起指令与远程协作。',
        tags: ['局域网直连', '可选加密中继', '移动端'],
      },
      xiaozhi: {
        tagline: '硬件多模态伙伴与小智接入',
        desc: '把麦克风、扬声器、屏幕、舵机等硬件能力接入 NomiFun 伙伴，让桌面 Agent 走进真实设备与更多交互场景。',
        tags: ['硬件伙伴', '语音与多模态', '开放接入'],
      },
      'net-infra': {
        tagline: '自托管的跨网络中继基础设施',
        desc: 'NomiRelay 用 QUIC 优先、TLS/TCP 回退的承载，把 NAT 后的 HTTP、WebSocket、TCP 与 UDP 服务安全提供给手机和 IoT 设备，并保留清晰的运维与权限边界。',
        tags: ['自托管', 'QUIC / TCP / UDP', 'MIT'],
      },
    },
    friendsEyebrow: '友情推荐',
    friendsTitle: '我们也<span class="text-grad-pink">由衷喜欢</span>的好产品',
    friendsLead: '除了 NomiFun，这些也是我们愿意分享给你的其他好产品。它们各自解决不同问题，也给过我们很多启发。',
    visit: '前往了解',
    products: {
      saytive: {
        tagline: 'Be Creative, Be Saytive.',
        category: '创意语音输入法',
        desc: '专为创意工作者打造的语音输入法。通过模型与产品设计感知工作上下文，提供快速、准确而贴合场景的转写体验。',
        tags: ['语音转写', '上下文感知', '创意工作'],
      },
      fast: {
        tagline: '搜索，一触即达。',
        category: '极速搜索直达',
        desc: '只需输入文字并点击，即可直达小红书、抖音、美团等主流应用的搜索结果页。拒绝信息流，专注搜索本身。',
        tags: ['一触直达', '多应用', '无信息流'],
      },
      aionui: {
        tagline: '内置 Agent 引擎，安装即用。',
        category: 'AI Agent 工作台',
        desc: 'NomiFun 的部分 UI 设计借鉴了 AionUi，在此感谢它带来的设计启发。AionUi 也提供开箱即用的 Agent 工作体验。',
        tags: ['内置 Agent', '开箱即用', '设计启发'],
      },
    },
    bottomTitle: '想一起参与生态建设？',
    bottomBody: '欢迎提交代码、文档、问题反馈或真实使用经验。项目人力有限，但每一份认真贡献都会让这套公益性工具走得更远。',
    bottomCta: '联系我们',
  },
  'en-US': {
    eyebrow: 'OTHER PROJECTS',
    title: 'The NomiFun open-source family, <span class="text-grad-pink">built to make ideas real</span>',
    lead: 'This page puts the NomiFun open-source family first, while keeping a smaller list of products we genuinely recommend. NomiFun began as a tool for our own work and friends, so we keep its experimental, public-interest spirit and a deliberately measured pace.',
    familyTitle: 'NomiFun open-source family',
    familyEyebrow: 'OPEN-SOURCE FAMILY',
    familyLead: 'One local-first Agent Desktop foundation spanning desktop, mobile access, hardware companions, and self-hosted network relaying. Every repository is open for reading, forking, and building on.',
    repoVisit: 'View on GitHub',
    giteeVisit: 'China mirror on Gitee',
    repos: {
      desktop: {
        tagline: 'The cross-platform Agent Desktop workbench',
        desc: 'The core NomiFun desktop app. Open source, free to commercialize, and available on Windows, macOS, and Linux, bringing together multi-provider models, multi-agent work, terminals, WebUI remote control, knowledge, automation, and local companions.',
        tags: ['Windows · macOS · Linux', 'Apache-2.0', 'Your computer is the server'],
      },
      mobile: {
        tagline: 'A mobile bridge to your own Desktop',
        desc: 'A lightweight mobile entry point that prefers a direct LAN connection to your Desktop and can use an end-to-end encrypted relay when you explicitly deploy one for cross-network access.',
        tags: ['Direct LAN link', 'Optional encrypted relay', 'Mobile'],
      },
      xiaozhi: {
        tagline: 'Hardware multimodal companions',
        desc: 'Connect microphones, speakers, displays, servos, and other hardware capabilities to NomiFun companions, bringing desktop agents into physical devices and new interaction surfaces.',
        tags: ['Hardware companions', 'Voice & multimodal', 'Open integration'],
      },
      'net-infra': {
        tagline: 'Self-hosted cross-network relay infrastructure',
        desc: 'NomiRelay uses QUIC-first transport with TLS/TCP fallback to expose HTTP, WebSocket, TCP, and UDP services behind NAT to phones and IoT devices while preserving explicit operator and trust boundaries.',
        tags: ['Self-hosted', 'QUIC / TCP / UDP', 'MIT'],
      },
    },
    friendsEyebrow: 'FRIENDLY PICKS',
    friendsTitle: 'Products we <span class="text-grad-pink">genuinely love</span> too',
    friendsLead: 'Beyond NomiFun, these are other thoughtful products we are happy to share. Each solves a different problem and has influenced our work in its own way.',
    visit: 'Visit',
    products: {
      saytive: {
        tagline: 'Be Creative, Be Saytive.',
        category: 'Voice input for creators',
        desc: 'A voice input method for creative workers, designed to understand working context and deliver fast, accurate transcription.',
        tags: ['Transcription', 'Context-aware', 'Creative work'],
      },
      fast: {
        tagline: 'Search, one tap away.',
        category: 'Instant search launcher',
        desc: 'Type once and jump straight to search results across mainstream apps. No feed, just the destination you asked for.',
        tags: ['One tap', 'Many apps', 'No feed'],
      },
      aionui: {
        tagline: 'Built-in agent engine. Ready on install.',
        category: 'AI agent workspace',
        desc: 'Part of NomiFun’s UI was inspired by AionUi; we are grateful for that design reference. AionUi also offers an approachable, ready-to-use Agent workspace.',
        tags: ['Built-in agents', 'Ready to use', 'Design reference'],
      },
    },
    bottomTitle: 'Want to help build the ecosystem?',
    bottomBody: 'Code, documentation, issue reports, and real-world feedback are all welcome. Bandwidth is limited, but every careful contribution helps this public-interest project go further.',
    bottomCta: 'Contact us',
  },
};

const t = pick(copy, locale);

const accentMap = {
  pink: {
    tile: 'border-pink-500/30 bg-pink-500/10 text-pink-400',
    btn: 'btn-primary',
    tag: 'border-pink-500/25 text-pink-200',
  },
  violet: {
    tile: 'border-violet-400/30 bg-violet-500/10 text-violet-300',
    btn: 'btn-ghost',
    tag: 'border-violet-400/25 text-violet-200',
  },
  cyan: {
    tile: 'border-cyan-400/30 bg-cyan-500/10 text-cyan-200',
    btn: 'btn-ghost',
    tag: 'border-cyan-400/25 text-cyan-100',
  },
  amber: {
    tile: 'border-amber-300/30 bg-amber-400/10 text-amber-200',
    btn: 'btn-ghost',
    tag: 'border-amber-300/25 text-amber-100',
  },
};
---

<section class="relative section-y bg-mesh">
  <div class="container-x">
    <div class="flex max-w-4xl flex-col gap-4" data-animate>
      <span class="eyebrow">{t.eyebrow}</span>
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-hi sm:text-5xl">
        <Fragment set:html={t.title} />
      </h1>
      <p class="text-base leading-relaxed text-mid sm:text-lg">{t.lead}</p>
    </div>

    <div class="mt-14" data-animate>
      <div class="flex max-w-3xl flex-col gap-3">
        <span class="eyebrow text-pink-300">{t.familyEyebrow}</span>
        <h2 class="text-3xl font-bold tracking-tight text-hi sm:text-4xl">{t.familyTitle}</h2>
        <p class="text-base leading-relaxed text-mid sm:text-lg">{t.familyLead}</p>
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-2" data-stagger>
        {ecosystemRepos.map((repo) => {
          const c = t.repos[repo.id];
          const a = accentMap[repo.accent];
          return (
            <article class="card card-hover flex flex-col p-6 sm:p-7">
              <div class="flex items-start justify-between gap-4">
                <span class={`flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl border text-2xl ${a.tile}`} aria-hidden="true">
                  <span class={repo.icon}></span>
                </span>
                <span class="rounded-full border border-ink-600 bg-ink-800/60 px-2.5 py-1 text-[11px] font-mono text-low">open source</span>
              </div>
              <h3 class="mt-5 text-xl font-bold text-hi">{repo.name}</h3>
              <p class="mt-2 text-base font-semibold text-grad-pink">{c.tagline}</p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-mid">{c.desc}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {c.tags.map((tag) => (
                  <span class={`inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] ${a.tag}`}>{tag}</span>
                ))}
              </div>
              <div class="mt-7 flex flex-wrap gap-2">
                <a href={repo.url} target="_blank" rel="noopener" class={`${a.btn} text-sm`}>
                  <span class="i-mdi-github text-base" aria-hidden="true"></span>
                  {t.repoVisit}
                  <span class="i-mdi-arrow-top-right text-base" aria-hidden="true"></span>
                </a>
                <a href={repo.giteeUrl} target="_blank" rel="noopener" class="btn-ghost text-sm">
                  <span class="i-simple-icons-gitee text-base" aria-hidden="true"></span>
                  {t.giteeVisit}
                  <span class="i-mdi-arrow-top-right text-base" aria-hidden="true"></span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div class="mt-20 border-t border-ink-700/70 pt-16" data-animate>
      <div class="flex max-w-3xl flex-col gap-3">
        <span class="eyebrow">{t.friendsEyebrow}</span>
        <h2 class="text-3xl font-bold leading-tight tracking-tight text-hi sm:text-4xl">
          <Fragment set:html={t.friendsTitle} />
        </h2>
        <p class="text-base leading-relaxed text-mid sm:text-lg">{t.friendsLead}</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-stagger>
        {PRODUCTS.map((p) => {
          const c = t.products[p.id];
          const a = accentMap[p.accent];
          return (
            <article class="card card-hover flex flex-col p-7 sm:p-8">
              <div class="flex items-center gap-4">
                <span class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border text-2xl ${a.tile}`} aria-hidden="true">
                  <span class={p.icon}></span>
                </span>
                <div class="min-w-0">
                  <h3 class="text-xl font-bold text-hi">{p.name}</h3>
                  <a href={p.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs text-low transition-colors hover:text-pink-300">
                    <span class="i-mdi-link-variant text-xs" aria-hidden="true"></span>{p.domain}
                  </a>
                </div>
              </div>
              <p class="mt-5 text-lg font-semibold text-grad-pink">{c.tagline}</p>
              <span class={`mt-3 inline-flex w-fit items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium ${a.tag}`}>
                {c.category}
              </span>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-mid">{c.desc}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {c.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-ink-600 bg-ink-700/50 px-2.5 py-1 text-[11px] text-mid">{tag}</span>
                ))}
              </div>
              <a href={p.url} target="_blank" rel="noopener" class={`mt-7 ${a.btn} text-sm`}>
                <span class="i-mdi-arrow-top-right text-base" aria-hidden="true"></span>
                {t.visit} {p.name}
              </a>
            </article>
          );
        })}
      </div>
    </div>

    <div class="mt-12 rounded-3xl border border-ink-600/70 bg-ink-850/50 p-8 text-center sm:p-10" data-animate>
      <h3 class="text-xl font-semibold text-hi sm:text-2xl">{t.bottomTitle}</h3>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-mid">{t.bottomBody}</p>
      <a href={localizePath('/contact', locale)} class="btn-ghost mt-6 text-sm">
        <span class="i-mdi-email-heart-outline text-base" aria-hidden="true"></span>
        {t.bottomCta}
        <span class="i-mdi-arrow-right text-base" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>
