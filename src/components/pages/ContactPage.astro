---
/**
 * ContactPage — shared implementation for /contact, /zh/contact, and legacy /en/contact.
 * Reads the active locale from Astro.url so zh + en share one file.
 *
 * Accuracy (§3, §8): NomiFun is Apache-2.0, free for commercial use with no
 * authorization required — the "commercial heads-up" panel is an invitation
 * for recognition/feedback, NOT a license condition. The GitHub repo and
 * official website and public contact email are live.
 */
import { getLocale, pick, type Dict, type Locale } from '@/i18n';
import { links, community, socialLinks } from '@/data/links';
import Badge from '@/components/ui/Badge.astro';

const locale: Locale = getLocale(Astro.url);

type Role = { icon: string; title: string; body: string };
type Panel = { icon: string; title: string; body: string };
type LinkCopy = { label: string; caption: string };
type SocialCopy = {
  xiaohongshu: LinkCopy;
  bilibili: LinkCopy;
  douyin: LinkCopy;
  youtube: LinkCopy;
  x: LinkCopy;
  tiktok: LinkCopy;
};

const copy: Dict<{
  eyebrow: string;
  title: string;
  titleHi: string;
  lead: string;
  rolesTitle: string;
  rolesLead: string;
  rolesNeed: string;
  roles: Role[];
  commercial: Panel & { badge: string };
  support: Panel & { badge: string };
  contactTitle: string;
  contactLead: string;
  primaryTitle: string;
  primaryLead: string;
  chinaTitle: string;
  chinaLead: string;
  globalTitle: string;
  globalLead: string;
  social: SocialCopy;
  emailLabel: string;
  emailCaption: string;
  placeholderTag: string;
  placeholderNote: string;
  qrTitle: string;
  qrLead: string;
  qrs: { label: string; caption: string }[];
}> = {
  'zh-CN': {
    eyebrow: '联系我们 · 共建',
    title: '与我们',
    titleHi: '一起共建',
    lead: '开发者兼职、精力有限，很多惊喜功能还在路上。如果你认同这件事，欢迎以任何方式加入——一行代码、一条建议、一次转发，都是莫大的鼓励。',
    rolesTitle: '共建召集',
    rolesLead: '目前很需要这些角色，欢迎对号入座，也欢迎自带想法来。',
    rolesNeed: '目前很需要',
    roles: [
      {
        icon: 'i-mdi-code-braces',
        title: '贡献代码',
        body: '修 bug、补功能、写测试、改文档都欢迎。从一个小 issue 起步，逐步深入后端 crate 或前端 island。',
      },
      {
        icon: 'i-mdi-account-group-outline',
        title: '社区运营',
        body: '帮忙搭建并照看社区：答疑、整理常见问题、组织讨论，让更多人顺利上手 NomiFun。',
      },
      {
        icon: 'i-mdi-bullhorn-outline',
        title: '布道者',
        body: '写教程、录演示、做分享——把本地优先、数据安全的 AI 工作站理念传播给更多人。',
      },
    ],
    commercial: {
      badge: '免费商用',
      icon: 'i-mdi-handshake-outline',
      title: '商用告知',
      body: 'Apache-2.0 授权下，你可以自由二次开发、免费商用，无需任何额外授权。如果你把它用在商业场景里，欢迎留言告知一声——这不是授权要求，只为换一份认可与正向反馈，让我们知道这件事被需要着。法律风险请自行评估并承担。',
    },
    support: {
      badge: '欢迎反馈',
      icon: 'i-mdi-help-circle-outline',
      title: '使用遇到问题？',
      body: '如果你在安装、模型供应商配置或开放能力使用上遇到问题，欢迎通过下面渠道反馈。我们会尽力在开源项目范围内提供建议，也欢迎把可复用经验沉淀成 issue、文档和社区答疑。',
    },
    contactTitle: '联系方式',
    contactLead: '以下渠道随时欢迎你来交流。GitHub 仓库、邮箱、境外社交媒体与国内平台入口已整理在这里。',
    primaryTitle: '直接联系',
    primaryLead: '适合提交问题、参与开发与正式联络；后续新增邮箱、表单或社群入口时也会继续放在这里。',
    chinaTitle: '国内平台快速访问',
    chinaLead: '小红书、B站与抖音的短链入口，适合在国内网络环境下快速打开。',
    globalTitle: '境外社交媒体',
    globalLead: 'YouTube、X 与 TikTok 会同步发布海外平台内容。',
    social: {
      xiaohongshu: { label: '小红书', caption: '国内平台短链' },
      bilibili: { label: 'B站', caption: '国内平台短链' },
      douyin: { label: '抖音', caption: '国内平台短链' },
      youtube: { label: 'YouTube', caption: '海外视频频道' },
      x: { label: 'X', caption: '@colir0' },
      tiktok: { label: 'TikTok', caption: '@colir0luo' },
    },
    emailLabel: '邮箱',
    emailCaption: links.email,
    placeholderTag: '占位待补',
    placeholderNote: '说明：上方标注「占位待补」的入口会在地址确定后第一时间替换。NomiFun Desktop、Mobile、Xiaozhi Yuntai 三个开源仓库、官网（www.nomifun.com）与联系邮箱已经可用。',
    qrTitle: '扫码加入社群',
    qrLead: '用微信 / QQ / 飞书扫码加群，也可以通过小红书 / B站 / 抖音找到我们。',
    qrs: [
      { label: '微信群', caption: '扫码加入微信群' },
      { label: 'QQ群', caption: '扫码加入 QQ 群' },
      { label: '飞书群', caption: '扫码加入飞书群' },
      { label: '小红书', caption: '扫码关注小红书' },
      { label: 'B站', caption: '扫码查看 B站主页' },
      { label: '抖音', caption: '扫码查看抖音主页' },
    ],
  },
  'en-US': {
    eyebrow: 'Contact · Build with us',
    title: 'Build',
    titleHi: 'with us',
    lead: 'This is a part-time effort with limited bandwidth, and many delightful features are still on the way. If this resonates with you, join in any way you like — a line of code, a suggestion, a reshare all mean a lot.',
    rolesTitle: 'A call for contributors',
    rolesLead: 'We really need these roles right now — pick one that fits, or bring your own idea.',
    rolesNeed: 'Needed right now',
    roles: [
      {
        icon: 'i-mdi-code-braces',
        title: 'Contribute code',
        body: 'Fix bugs, add features, write tests, improve docs — all welcome. Start from a small issue, then go deeper into a backend crate or a frontend island.',
      },
      {
        icon: 'i-mdi-account-group-outline',
        title: 'Community building',
        body: 'Help start and tend the community: answer questions, curate FAQs, host discussions, and help more people get NomiFun running.',
      },
      {
        icon: 'i-mdi-bullhorn-outline',
        title: 'Evangelist',
        body: 'Write tutorials, record demos, share talks — spread the idea of a local-first, privacy-safe AI workstation.',
      },
    ],
    commercial: {
      badge: 'Free commercial use',
      icon: 'i-mdi-handshake-outline',
      title: 'Commercial heads-up',
      body: 'Under Apache-2.0 you are free to fork, modify, and use NomiFun commercially — no extra authorization needed. If you do ship it commercially, we would love a quick note. This is not a license requirement — just a wish for some recognition and positive feedback so we know it is needed. Please assess and assume any legal risk yourself.',
    },
    support: {
      badge: 'Feedback welcome',
      icon: 'i-mdi-help-circle-outline',
      title: 'Need help using NomiFun?',
      body: 'If installation, model-provider configuration, or open-capability setup is getting in your way, reach out through the channels below. We will help within the scope of the open source project and turn reusable answers into issues, docs, and community guidance.',
    },
    contactTitle: 'Get in touch',
    contactLead: 'Reach out through any of the channels below. GitHub, email, global social profiles, and China-platform quick links are collected here.',
    primaryTitle: 'Direct contact',
    primaryLead: 'Best for issues, development collaboration, and formal email. Future email, form, or community entries can sit here as the channel list grows.',
    chinaTitle: 'China-platform quick links',
    chinaLead: 'Short links for RED (Xiaohongshu), Bilibili, and Douyin.',
    globalTitle: 'Global social media',
    globalLead: 'YouTube, X, and TikTok profiles for non-China social platforms.',
    social: {
      xiaohongshu: { label: 'RED', caption: 'Xiaohongshu quick link' },
      bilibili: { label: 'Bilibili', caption: 'China-platform quick link' },
      douyin: { label: 'Douyin', caption: 'China-platform quick link' },
      youtube: { label: 'YouTube', caption: 'Global video channel' },
      x: { label: 'X', caption: '@colir0' },
      tiktok: { label: 'TikTok', caption: '@colir0luo' },
    },
    emailLabel: 'Email',
    emailCaption: links.email,
    placeholderTag: 'Placeholder',
    placeholderNote: 'Note: links tagged “Placeholder” above will be replaced as soon as their destinations are confirmed. The NomiFun Desktop, Mobile, and Xiaozhi Yuntai repositories, website (www.nomifun.com), and contact email are already available.',
    qrTitle: 'Scan to join the community',
    qrLead: 'Scan to join the WeChat, QQ, or Feishu group, or find us through RED, Bilibili, and Douyin.',
    qrs: [
      { label: 'WeChat group', caption: 'Scan to join the WeChat group' },
      { label: 'QQ group', caption: 'Scan to join the QQ group' },
      { label: 'Feishu group', caption: 'Scan to join the Feishu group' },
      { label: 'RED (Xiaohongshu)', caption: 'Follow us on RED' },
      { label: 'Bilibili', caption: 'Open the Bilibili profile' },
      { label: 'Douyin', caption: 'Open the Douyin profile' },
    ],
  },
};

const t = pick(copy, locale);

// QR cards — real images live under public/images/zh/联系方式/<platform>/.
// Captured by the author; surfaced on both locales (illustrative contact QRs).
const qrImages = [
  { img: '/images/zh/联系方式/wechat-group/qr.png', icon: 'i-mdi-wechat', w: 1031, h: 1440 },
  { img: '/images/zh/联系方式/qq-group/qr.png', icon: 'i-mdi-qqchat', w: 1156, h: 2055 },
  { img: '/images/zh/联系方式/feishu-group/qr.jpg', icon: 'i-mdi-message-text-outline', w: 965, h: 1126 },
  { img: '/images/zh/联系方式/xhs/1280X1280.JPEG', icon: 'i-simple-icons-xiaohongshu', w: 937, h: 1280 },
  { img: '/images/zh/联系方式/bilibili/qr.png', icon: 'i-simple-icons-bilibili', w: 960, h: 960 },
  { img: '/images/zh/联系方式/douyin/qr.png', icon: 'i-mdi-music-note-eighth', w: 869, h: 1280 },
];
const qrs = qrImages.map((q, i) => ({ ...q, ...t.qrs[i] }));

// Community buttons: always include GitHub + email; keep placeholder handling
// for future channels that may be added before their destinations are final.
const isPlaceholderUrl = (url: string) =>
  !url || url === '#';

type ContactButton = {
  id: string;
  label: string;
  caption: string;
  href: string;
  icon: string;
  placeholder?: boolean;
};

const githubCaption = locale === 'zh-CN' ? '源码、Issue 与 Release' : 'Source, issues, and releases';

const primaryButtons: ContactButton[] = [
  ...community.map((c) => ({
    id: c.id,
    label: c.label,
    caption: c.id === 'github' ? githubCaption : c.url,
    href: c.url,
    icon: c.icon,
    placeholder: isPlaceholderUrl(c.url),
  })),
  {
    id: 'email',
    label: t.emailLabel,
    caption: t.emailCaption,
    href: `mailto:${links.email}`,
    icon: 'i-mdi-email-outline',
    placeholder: isPlaceholderUrl(links.email),
  },
];

const chinaPlatformButtons: ContactButton[] = [
  {
    id: 'xiaohongshu',
    ...t.social.xiaohongshu,
    href: socialLinks.xiaohongshu,
    icon: 'i-simple-icons-xiaohongshu',
  },
  {
    id: 'bilibili',
    ...t.social.bilibili,
    href: socialLinks.bilibili,
    icon: 'i-simple-icons-bilibili',
  },
  {
    id: 'douyin',
    ...t.social.douyin,
    href: socialLinks.douyin,
    icon: 'i-mdi-music-note-eighth',
  },
];

const globalPlatformButtons: ContactButton[] = [
  {
    id: 'youtube',
    ...t.social.youtube,
    href: socialLinks.youtube,
    icon: 'i-simple-icons-youtube',
  },
  {
    id: 'x',
    ...t.social.x,
    href: socialLinks.x,
    icon: 'i-simple-icons-x',
  },
  {
    id: 'tiktok',
    ...t.social.tiktok,
    href: socialLinks.tiktok,
    icon: 'i-simple-icons-tiktok',
  },
];

const dedupeButtons = (items: ContactButton[]) => {
  const seen = new Set<string>();
  return items.filter((item) => (seen.has(item.id) ? false : (seen.add(item.id), true)));
};

const primaryContactGroup = {
  id: 'primary',
  title: t.primaryTitle,
  lead: t.primaryLead,
  buttons: dedupeButtons(primaryButtons),
};

const platformContactGroups = [
  { id: 'global', title: t.globalTitle, lead: t.globalLead, buttons: globalPlatformButtons },
  { id: 'china', title: t.chinaTitle, lead: t.chinaLead, buttons: chinaPlatformButtons },
];

const contactGroups = [primaryContactGroup, ...platformContactGroups];

const anyPlaceholder = contactGroups.some((group) => group.buttons.some((button) => button.placeholder));
---

<!-- Page hero -->
<section class="relative overflow-hidden border-b border-ink-700/60">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-mesh"></div>
  <div
    class="pointer-events-none absolute left-1/2 top-[-30%] -z-10 h-[420px] w-[720px] -translate-x-1/2 rounded-full opacity-50 blur-3xl"
    style="background: radial-gradient(closest-side, rgba(255,111,145,0.18), transparent)"
  >
  </div>
  <div class="container-x flex flex-col items-center pt-20 pb-14 text-center sm:pt-24">
    <span class="eyebrow mb-5" data-animate>{t.eyebrow}</span>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.12] tracking-tight sm:text-5xl" data-animate>
      <span class="text-hi">{t.title}</span><span class="text-grad-pink"> {t.titleHi}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-mid sm:text-lg" data-animate>{t.lead}</p>
  </div>
</section>

<!-- Call for contributors -->
<section class="section-y">
  <div class="container-x">
    <div class="mb-12 flex max-w-3xl flex-col gap-4" data-animate>
      <span class="eyebrow">{t.rolesTitle}</span>
      <h2 class="text-3xl font-bold leading-tight tracking-tight text-hi sm:text-4xl">{t.rolesTitle}</h2>
      <p class="text-base leading-relaxed text-mid sm:text-lg">{t.rolesLead}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3" data-stagger>
      {
        t.roles.map((r) => (
          <article class="card card-hover flex flex-col gap-4 p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-ink-600 bg-ink-800/80">
                <span class={`${r.icon} text-2xl text-pink-400`} />
              </span>
              <Badge tone="pink"><span class="i-mdi-star-four-points-outline" />{t.rolesNeed}</Badge>
            </div>
            <h3 class="text-lg font-semibold text-hi">{r.title}</h3>
            <p class="text-sm leading-relaxed text-mid">{r.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Two info panels: commercial heads-up + support feedback -->
<section class="section-y pt-0">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-2" data-stagger>
      <article class="card flex flex-col gap-4 border-pink-500/20 bg-pink-500/[0.04] p-7">
        <div class="flex items-center gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-pink-500/25 bg-pink-500/10">
            <span class={`${t.commercial.icon} text-2xl text-pink-300`}></span>
          </span>
          <div class="flex flex-col gap-1.5">
            <Badge tone="success"><span class="i-mdi-cash-check"></span>{t.commercial.badge}</Badge>
            <h3 class="text-lg font-semibold text-hi">{t.commercial.title}</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-mid">{t.commercial.body}</p>
      </article>

      <article class="card flex flex-col gap-4 border-violet-400/20 bg-violet-500/[0.04] p-7">
        <div class="flex items-center gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-violet-400/25 bg-violet-500/10">
            <span class={`${t.support.icon} text-2xl text-violet-300`}></span>
          </span>
          <div class="flex flex-col gap-1.5">
            <Badge tone="violet"><span class="i-mdi-hand-heart-outline"></span>{t.support.badge}</Badge>
            <h3 class="text-lg font-semibold text-hi">{t.support.title}</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-mid">{t.support.body}</p>
      </article>
    </div>
  </div>
</section>

<!-- Contact channels -->
<section class="section-y border-t border-ink-700/60 bg-ink-850/40 pt-20">
  <div class="container-x">
    <div class="mb-10 flex max-w-3xl flex-col gap-4" data-animate>
      <span class="eyebrow">{t.contactTitle}</span>
      <h2 class="text-3xl font-bold leading-tight tracking-tight text-hi sm:text-4xl">{t.contactTitle}</h2>
      <p class="text-base leading-relaxed text-mid sm:text-lg">{t.contactLead}</p>
    </div>

    <div class="grid gap-9" data-stagger>
      <div class="flex flex-col gap-4">
        <div class="flex max-w-2xl flex-col gap-1.5">
          <h3 class="text-base font-semibold text-hi">{primaryContactGroup.title}</h3>
          <p class="text-sm leading-relaxed text-mid">{primaryContactGroup.lead}</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {
            primaryContactGroup.buttons.map((b) => (
              <a
                href={b.href}
                target={b.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={b.href.startsWith('mailto:') ? undefined : 'noopener'}
                class="card card-hover group flex min-h-[108px] items-center gap-3 p-5"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-ink-600 bg-ink-800/80 transition-colors group-hover:border-pink-500/40">
                  <span class={`${b.icon} text-2xl text-hi`} />
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class="text-sm font-semibold text-hi">{b.label}</span>
                  <span class="break-words text-xs leading-relaxed text-low">{b.caption}</span>
                  {b.placeholder && <Badge tone="soon" class="self-start">{t.placeholderTag}</Badge>}
                </span>
                {!b.href.startsWith('mailto:') && (
                  <span class="i-mdi-arrow-top-right text-base text-low transition-colors group-hover:text-pink-300" aria-hidden="true" />
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid gap-8">
        {
          platformContactGroups.map((group) => (
            <div class="flex flex-col gap-4">
              <div class="flex max-w-2xl flex-col gap-1.5">
                <h3 class="text-base font-semibold text-hi">{group.title}</h3>
                <p class="text-sm leading-relaxed text-mid">{group.lead}</p>
              </div>

              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {group.buttons.map((b) => (
                  <a
                    href={b.href}
                    target={b.href.startsWith('mailto:') ? undefined : '_blank'}
                    rel={b.href.startsWith('mailto:') ? undefined : 'noopener'}
                    class="card card-hover group flex min-h-[108px] items-center gap-3 p-5"
                  >
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-ink-600 bg-ink-800/80 transition-colors group-hover:border-pink-500/40">
                      <span class={`${b.icon} text-2xl text-hi`} />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col gap-1">
                      <span class="text-sm font-semibold text-hi">{b.label}</span>
                      <span class="break-words text-xs leading-relaxed text-low">{b.caption}</span>
                      {b.placeholder && <Badge tone="soon" class="self-start">{t.placeholderTag}</Badge>}
                    </span>
                    {!b.href.startsWith('mailto:') && (
                      <span class="i-mdi-arrow-top-right text-base text-low transition-colors group-hover:text-pink-300" aria-hidden="true" />
                    )}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- community QR codes -->
    <div class="mt-12">
      <div class="mb-6 flex flex-col gap-2" data-animate>
        <h3 class="text-lg font-semibold text-hi">{t.qrTitle}</h3>
        <p class="text-sm leading-relaxed text-mid">{t.qrLead}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {
          qrs.map((q) => (
            <figure class="card flex flex-col items-center gap-3 p-5 text-center">
              <span class="flex items-center gap-2 text-sm font-semibold text-hi">
                <span class={`${q.icon} text-lg text-pink-400`} aria-hidden="true" />
                {q.label}
              </span>
              <span class="overflow-hidden rounded-xl border border-ink-600 bg-white p-2">
                <img
                  src={q.img}
                  alt={`${q.label} · ${q.caption}`}
                  width={q.w}
                  height={q.h}
                  loading="lazy"
                  decoding="async"
                  class="block h-44 w-44 object-contain"
                />
              </span>
              <figcaption class="flex items-center gap-1 text-xs text-low">
                <span class="i-mdi-qrcode-scan text-sm" aria-hidden="true" />
                {q.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    {
      anyPlaceholder && (
        <p class="mt-8 flex max-w-3xl items-start gap-2 text-xs leading-relaxed text-low" data-animate>
          <span class="i-mdi-information-outline mt-0.5 shrink-0 text-sm" />
          <span>{t.placeholderNote}</span>
        </p>
      )
    }
  </div>
</section>
