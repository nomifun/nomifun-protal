---
/**
 * DownloadPage — shared implementation for /download, /zh/download, and legacy /en/download.
 * Reads the active locale from Astro.url so zh + en share one file.
 *
 * Platform cards map over `downloads` data. Official install entry points
 * include desktop installers from GitHub Releases and the Docker Hub image.
 * Source-build and advanced self-host paths remain documented.
 */
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';
import { links, downloads, meta } from '@/data/links';
import Badge from '@/components/ui/Badge.astro';

const locale: Locale = getLocale(Astro.url);

type InstallPath = {
  icon: string;
  title: string;
  desc: string;
  /** code block lines, rendered in a <pre> */
  cmds: string[];
  note?: string;
};

type PlatformCopy = { reqTitle: string; comingSoon: string; download: string };

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  officialTitle: string;
  officialLead: string;
  bannerTitle: string;
  bannerBody: string;
  releasesCta: string;
  dockerBadge: string;
  dockerTitle: string;
  dockerBody: string;
  dockerHubCta: string;
  dockerCommands: string[];
  baiduTitle: string;
  baiduBody: string;
  baiduCta: string;
  baiduFile: string;
  baiduCode: string;
  pathsTitle: string;
  pathsLead: string;
  paths: InstallPath[];
  platformTitle: string;
  platformLead: string;
  platform: PlatformCopy;
  reqTitle: string;
  reqLead: string;
  reqs: { icon: string; title: string; body: string }[];
  docsCta: string;
  githubCta: string;
}> = {
  'zh-CN': {
    eyebrow: '下载 · 自托管',
    title: '获取 NomiFun',
    lead: '本地优先的超级 AI 工作站，完全开源、免费商用。现已提供 Windows、macOS 与 Linux 桌面安装包，也可以从源码构建或通过 Docker 自托管。',
    officialTitle: '官方安装入口',
    officialLead: '桌面安装包与 Docker 官方镜像是并列的官方安装方式。桌面端适合个人电脑使用，Docker 镜像适合服务器、NAS、内网主机或云主机长期运行。',
    bannerTitle: 'Windows、macOS 与 Linux 安装包已发布',
    bannerBody:
      '官方下载统一在 GitHub Releases。Windows 选择 x64 setup.exe，macOS 选择 universal.dmg；Linux x86_64 可选 AppImage、Debian（.deb）或 RPM。各平台由原生构建机依次追加，若最新标签尚未出现你的平台，请选最近一个包含对应安装包的版本。',
    releasesCta: '打开 GitHub Releases',
    dockerBadge: 'Docker Hub',
    dockerTitle: '官方 Docker 镜像',
    dockerBody:
      '官方镜像为 nomifun-web 无头服务，默认在 8787 端口提供 WebUI、API 与 WebSocket。建议挂载 /data 保存状态，并在公网部署时放到 TLS 反向代理后面。',
    dockerHubCta: '打开 Docker Hub',
    dockerCommands: [
      'docker pull nomifun/nomifun-web:latest',
      'docker run -d --name nomifun-web --restart unless-stopped -p 8787:8787 -v nomifun-data:/data nomifun/nomifun-web:latest',
      '# 打开 http://<server-ip>:8787',
    ],
    baiduTitle: '中国区备用：百度网盘',
    baiduBody:
      '为中国区用户提供 nomifun 网盘分享，下载不稳定或访问 GitHub 较慢时可使用。GitHub Releases 仍是官方发布源。',
    baiduCta: '百度网盘下载',
    baiduFile: '分享内容：nomifun',
    baiduCode: '无需提取码',
    pathsTitle: '源码与高级部署路径',
    pathsLead: '已经可以直接下载安装包或拉取官方镜像；只有需要自行编译、改构建参数或维护 Compose 编排时，才使用下面这些路径。',
    paths: [
      {
        icon: 'i-mdi-desktop-classic',
        title: '桌面源码构建（Tauri）',
        desc: '构建 nomifun-desktop 桌面应用：环回端口 + 每次启动本地信任 token。',
        cmds: ['bun install', 'bun run build:ui', 'bun run build'],
        note: '产物为各平台桌面安装包（见下方平台支持）。',
      },
      {
        icon: 'i-mdi-server-network',
        title: 'Web 服务源码',
        desc: '构建并启动自托管 Web 服务（axum）。默认绑定 127.0.0.1:8787，需登录。',
        cmds: ['bun run build:ui', 'bun run serve:web'],
        note: '绑定 127.0.0.1:8787，默认需登录。',
      },
      {
        icon: 'i-simple-icons-docker',
        title: 'Docker Compose 源码构建',
        desc: '从仓库 Dockerfile 构建并后台运行，适合需要改 Compose、Caddy 或构建参数的自托管场景。',
        cmds: ['docker compose up -d --build', '# 打开 http://<server-ip>:8787'],
        note: '只想直接部署时优先使用上方官方镜像。',
      },
    ],
    platformTitle: '平台支持',
    platformLead: '桌面端现已覆盖三大平台。所有按钮都会打开 GitHub Releases，请按文件名选择对应安装包。',
    platform: { reqTitle: '系统要求', comingSoon: 'GitHub Releases', download: '下载' },
    reqTitle: '系统要求 & 自托管',
    reqLead: '从源码构建或自托管运行前，请留意以下环境要求与生产部署建议。',
    reqs: [
      {
        icon: 'i-simple-icons-windows',
        title: 'Windows：需要 WebView2',
        body: '桌面端依赖 Microsoft WebView2 运行时（Win11 已内置；Win10 如缺失会在安装时引导获取）。当前发布 x64 setup.exe。',
      },
      {
        icon: 'i-simple-icons-linux',
        title: 'Linux：三种安装格式',
        body: 'Linux x86_64 提供免安装 AppImage，以及适用于 Debian / Ubuntu 的 .deb 和适用于 Fedora / RHEL 系的 .rpm。首次启动请确保系统已安装 WebKitGTK 4.1。',
      },
      {
        icon: 'i-mdi-lock-check-outline',
        title: 'Caddy TLS 反向代理',
        body: '生产环境建议在 Web 服务（127.0.0.1:8787）前挂一层 Caddy 反向代理，自动签发并续期 HTTPS 证书。',
      },
    ],
    docsCta: '查看操作文档',
    githubCta: '在 GitHub 查看源码',
  },
  'en-US': {
    eyebrow: 'Download · Self-host',
    title: 'Get NomiFun',
    lead: 'A local-first super AI workstation — fully open source and free for commercial use. Desktop installers are now available for Windows, macOS, and Linux; source builds and Docker self-hosting remain available.',
    officialTitle: 'Official install options',
    officialLead:
      'Desktop installers and the official Docker image are peer install paths. Use the desktop app on a personal machine, or run the Docker image on a server, NAS, LAN host, or VPS.',
    bannerTitle: 'Windows, macOS, and Linux builds are live',
    bannerBody:
      'Official downloads live on GitHub Releases. Choose the x64 setup.exe for Windows, universal.dmg for macOS, or AppImage, Debian (.deb), or RPM for Linux x86_64. Native build machines append platforms in sequence, so if the newest tag does not include yours yet, use the most recent release that does.',
    releasesCta: 'Open GitHub Releases',
    dockerBadge: 'Docker Hub',
    dockerTitle: 'Official Docker image',
    dockerBody:
      'The official image runs the headless nomifun-web service and serves the WebUI, API, and WebSocket on port 8787 by default. Mount /data for state, and put public deployments behind a TLS reverse proxy.',
    dockerHubCta: 'Open Docker Hub',
    dockerCommands: [
      'docker pull nomifun/nomifun-web:latest',
      'docker run -d --name nomifun-web --restart unless-stopped -p 8787:8787 -v nomifun-data:/data nomifun/nomifun-web:latest',
      '# open http://<server-ip>:8787',
    ],
    baiduTitle: 'China mirror: Baidu Netdisk',
    baiduBody:
      'For users in mainland China, the nomifun share is also available through Baidu Netdisk when GitHub access is slow. GitHub Releases remains the canonical release source.',
    baiduCta: 'Download via Baidu Netdisk',
    baiduFile: 'Shared item: nomifun',
    baiduCode: 'No extraction code',
    pathsTitle: 'Source and advanced deployment paths',
    pathsLead:
      'Installers and the official Docker image are ready to use. Use these paths only when you need to compile from source, customize build flags, or maintain Compose orchestration.',
    paths: [
      {
        icon: 'i-mdi-desktop-classic',
        title: 'Desktop from source (Tauri)',
        desc: 'Build the nomifun-desktop app: loopback port + a local trust token minted on each launch.',
        cmds: ['bun install', 'bun run build:ui', 'bun run build'],
        note: 'Produces a desktop installer per platform (see platform support below).',
      },
      {
        icon: 'i-mdi-server-network',
        title: 'Web server from source',
        desc: 'Build and start the self-hosted web server (axum). Binds 127.0.0.1:8787, login required.',
        cmds: ['bun run build:ui', 'bun run serve:web'],
        note: 'Binds 127.0.0.1:8787, login required by default.',
      },
      {
        icon: 'i-simple-icons-docker',
        title: 'Build with Docker Compose',
        desc: 'Build from the repo Dockerfile and run in the background when you need custom Compose, Caddy, or build settings.',
        cmds: ['docker compose up -d --build', '# open http://<server-ip>:8787'],
        note: 'For a direct deployment, prefer the official image above.',
      },
    ],
    platformTitle: 'Platform support',
    platformLead: 'The desktop app now covers all three major platforms. Each button opens GitHub Releases; choose the matching installer filename.',
    platform: { reqTitle: 'Requirements', comingSoon: 'GitHub Releases', download: 'Download' },
    reqTitle: 'Requirements & self-host',
    reqLead: 'Before building from source or self-hosting, note these environment requirements and production deployment tips.',
    reqs: [
      {
        icon: 'i-simple-icons-windows',
        title: 'Windows: needs WebView2',
        body: 'The desktop app requires Microsoft WebView2 (bundled on Win11; the installer guides you to fetch it on Win10 if missing). Current releases ship an x64 setup.exe.',
      },
      {
        icon: 'i-simple-icons-linux',
        title: 'Linux: three package formats',
        body: 'Linux x86_64 builds include a portable AppImage, a .deb for Debian / Ubuntu, and an .rpm for Fedora / RHEL families. Make sure WebKitGTK 4.1 is installed before first launch.',
      },
      {
        icon: 'i-mdi-lock-check-outline',
        title: 'Caddy TLS reverse proxy',
        body: 'In production, put a Caddy reverse proxy in front of the web server (127.0.0.1:8787) to issue and auto-renew HTTPS certificates.',
      },
    ],
    docsCta: 'Read the docs',
    githubCta: 'View source on GitHub',
  },
};

const t = pick(copy, locale);

// Platform cards from data. Order is intentional: macOS / Windows / Linux.
const platformIcons: Record<string, string> = {
  macos: 'i-simple-icons-apple',
  windows: 'i-simple-icons-windows',
  linux: 'i-simple-icons-linux',
};
const platformList = (['macos', 'windows', 'linux'] as const).map((key) => ({
  key,
  icon: platformIcons[key],
  ...downloads[key],
}));
---

<!-- Page hero -->
<section class="relative overflow-hidden border-b border-ink-700/60">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-mesh"></div>
  <div
    class="pointer-events-none absolute left-1/2 top-[-30%] -z-10 h-[420px] w-[720px] -translate-x-1/2 rounded-full opacity-50 blur-3xl"
    style="background: radial-gradient(closest-side, rgba(255,111,145,0.18), transparent)"
  >
  </div>
  <div class="container-x flex flex-col items-center pt-20 pb-14 text-center sm:pt-24">
    <span class="eyebrow mb-5" data-animate>{t.eyebrow}</span>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.12] tracking-tight text-hi sm:text-5xl" data-animate>
      {t.title}
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-mid sm:text-lg" data-animate>{t.lead}</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-low" data-animate>
      <Badge tone="neutral">v{meta.version}</Badge>
      <Badge tone="soon">{meta.status}</Badge>
      <Badge tone="violet">{meta.license}</Badge>
    </div>
  </div>
</section>

<!-- Official install options -->
<section class="container-x mt-10">
  <div class="mb-5 flex max-w-3xl flex-col gap-3" data-animate>
    <h2 class="text-2xl font-bold leading-tight tracking-tight text-hi sm:text-3xl">{t.officialTitle}</h2>
    <p class="text-sm leading-relaxed text-mid sm:text-base">{t.officialLead}</p>
  </div>

  <div class="grid gap-6 lg:grid-cols-2" data-stagger>
    <article class="card card-hover flex min-w-0 flex-col gap-4 border-warning/25 bg-warning/5 p-5 sm:p-6">
      <div class="flex flex-wrap items-center gap-3">
        <Badge tone="soon"><span class="i-mdi-progress-wrench"></span>{t.platform.comingSoon}</Badge>
        <h3 class="text-base font-semibold text-hi sm:text-lg">{t.bannerTitle}</h3>
      </div>
      <p class="text-sm leading-relaxed text-mid">{t.bannerBody}</p>
      <a href={links.releases} target="_blank" rel="noopener" class="btn-primary w-fit text-sm">
        <span class="i-mdi-github text-base"></span>{t.releasesCta}
      </a>
      <div class="mt-auto flex flex-col gap-3 border-t border-ink-700/70 pt-4">
        <div class="flex items-center gap-2 text-sm font-semibold text-hi">
          <span class="i-mdi-cloud-download-outline text-lg text-violet-300"></span>
          <span>{t.baiduTitle}</span>
        </div>
        <p class="text-sm leading-relaxed text-mid">{t.baiduBody}</p>
        <div class="flex flex-wrap gap-2">
          <Badge tone="neutral">{t.baiduFile}</Badge>
          <Badge tone="success">{t.baiduCode}</Badge>
        </div>
        <a href={links.baiduPan} target="_blank" rel="noopener" class="btn-ghost w-fit shrink-0 text-sm">
          <span class="i-mdi-link-variant text-base"></span>{t.baiduCta}
        </a>
      </div>
    </article>

    <article class="card card-hover flex min-w-0 flex-col gap-4 border-pink-500/25 bg-pink-500/5 p-5 sm:p-6">
      <div class="flex flex-wrap items-center gap-3">
        <Badge tone="violet"><span class="i-simple-icons-docker"></span>{t.dockerBadge}</Badge>
        <h3 class="text-base font-semibold text-hi sm:text-lg">{t.dockerTitle}</h3>
      </div>
      <p class="text-sm leading-relaxed text-mid">{t.dockerBody}</p>
      <pre class="group relative min-w-0 max-w-full overflow-x-auto rounded-xl border border-ink-700 bg-ink-950/70 p-4 font-mono text-[13px] leading-relaxed text-hi"><span class="pointer-events-none absolute right-3 top-3 text-[11px] text-low"><span class="i-mdi-content-copy align-middle" /></span>{t.dockerCommands.map((line) => (
        <span class={`block ${line.startsWith('#') ? 'text-low' : ''}`}><span class="select-none text-pink-400/70">{line.startsWith('#') ? '  ' : '$ '}</span>{line.replace(/^#\s?/, '# ')}</span>
      ))}</pre>
      <div class="mt-auto flex flex-wrap gap-3">
        <a href={links.dockerHub} target="_blank" rel="noopener" class="btn-primary text-sm">
          <span class="i-simple-icons-docker text-base"></span>{t.dockerHubCta}
        </a>
        <a href={localizePath('/docs/getting-started/installation', locale)} class="btn-ghost text-sm">
          <span class="i-mdi-book-open-variant text-base"></span>{t.docsCta}
        </a>
      </div>
    </article>
  </div>
</section>

<!-- Three install paths -->
<section class="section-y">
  <div class="container-x">
    <div class="mb-12 flex max-w-3xl flex-col gap-4" data-animate>
      <h2 class="text-3xl font-bold leading-tight tracking-tight text-hi sm:text-4xl">{t.pathsTitle}</h2>
      <p class="text-base leading-relaxed text-mid sm:text-lg">{t.pathsLead}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3" data-stagger>
      {
        t.paths.map((p) => (
          <article class="card card-hover flex min-w-0 flex-col gap-4 p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-ink-600 bg-ink-800/80">
                <span class={`${p.icon} text-2xl text-pink-400`} />
              </span>
              <h3 class="text-lg font-semibold text-hi">{p.title}</h3>
            </div>
            <p class="text-sm leading-relaxed text-mid">{p.desc}</p>
            <pre class="group relative min-w-0 max-w-full overflow-x-auto rounded-xl border border-ink-700 bg-ink-950/70 p-4 font-mono text-[13px] leading-relaxed text-hi"><span class="pointer-events-none absolute right-3 top-3 text-[11px] text-low"><span class="i-mdi-content-copy align-middle" /></span>{p.cmds.map((line) => (
              <span class={`block ${line.startsWith('#') ? 'text-low' : ''}`}><span class="select-none text-pink-400/70">{line.startsWith('#') ? '  ' : '$ '}</span>{line.replace(/^#\s?/, '# ')}</span>
            ))}</pre>
            {p.note && (
              <p class="flex items-start gap-1.5 text-xs leading-relaxed text-low">
                <span class="i-mdi-information-outline mt-0.5 shrink-0 text-sm" />
                <span>{p.note}</span>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Platform grid -->
<section class="section-y pt-0">
  <div class="container-x">
    <div class="mb-12 flex max-w-3xl flex-col gap-4" data-animate>
      <h2 class="text-3xl font-bold leading-tight tracking-tight text-hi sm:text-4xl">{t.platformTitle}</h2>
      <p class="text-base leading-relaxed text-mid sm:text-lg">{t.platformLead}</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        platformList.map((p) => (
          <article class="card flex flex-col gap-5 p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-ink-600 bg-ink-800/80">
                <span class={`${p.icon} text-2xl text-hi`} />
              </span>
              <div class="flex flex-col">
                <span class="text-lg font-semibold text-hi">{p.label}</span>
                <span class="font-mono text-xs text-low">{p.ext}</span>
              </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-mid">
              <span class="i-mdi-chip text-sm text-violet-300" />
              <span>{p.arch}</span>
            </div>
            {p.url ? (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="btn-primary mt-auto w-full justify-center text-sm"
              >
                <span class="i-mdi-download text-base" />
                {t.platform.download} {p.label}
              </a>
            ) : (
              <button
                type="button"
                disabled
                aria-disabled="true"
                class="mt-auto inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl border border-ink-600 bg-ink-800/50 px-5 py-2.5 text-sm font-medium text-low opacity-80"
              >
                <span class="i-mdi-clock-outline text-base" />
                {t.platform.comingSoon}
              </button>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Requirements & self-host -->
<section class="section-y border-t border-ink-700/60 bg-ink-850/40 pt-20">
  <div class="container-x">
    <div class="mb-12 flex max-w-3xl flex-col gap-4" data-animate>
      <span class="eyebrow">{t.reqTitle}</span>
      <h2 class="text-3xl font-bold leading-tight tracking-tight text-hi sm:text-4xl">{t.reqTitle}</h2>
      <p class="text-base leading-relaxed text-mid sm:text-lg">{t.reqLead}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3" data-stagger>
      {
        t.reqs.map((r) => (
          <article class="card card-hover flex flex-col gap-3 p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-ink-600 bg-ink-800/80">
              <span class={`${r.icon} text-xl text-violet-300`} />
            </span>
            <h3 class="text-base font-semibold text-hi">{r.title}</h3>
            <p class="text-sm leading-relaxed text-mid">{r.body}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col items-start gap-3 sm:flex-row" data-animate>
      <a href={localizePath('/docs', locale)} class="btn-primary text-sm">
        <span class="i-mdi-book-open-variant text-base"></span>{t.docsCta}
      </a>
      <a href={links.github} target="_blank" rel="noopener" class="btn-ghost text-sm">
        <span class="i-mdi-github text-base"></span>{t.githubCta}
      </a>
    </div>
  </div>
</section>
