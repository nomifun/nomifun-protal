---
import { getLocale, type Locale } from '@/i18n';

const locale: Locale = getLocale(Astro.url);
const label = locale === 'zh-CN' ? '切换亮色/暗黑主题' : 'Switch light/dark theme';
const darkLabel = locale === 'zh-CN' ? '当前为暗黑主题，点击切换为亮色主题' : 'Dark theme active, switch to light theme';
const lightLabel = locale === 'zh-CN' ? '当前为亮色主题，点击切换为暗黑主题' : 'Light theme active, switch to dark theme';
---

<button
  type="button"
  data-theme-toggle
  data-label-dark={darkLabel}
  data-label-light={lightLabel}
  aria-label={darkLabel}
  aria-pressed="false"
  title={darkLabel}
  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-ink-600 text-mid transition-colors hover:border-violet-400/60 hover:text-hi"
>
  <span data-theme-icon class="i-mdi-weather-night text-lg" aria-hidden="true"></span>
  <span class="sr-only">{label}</span>
</button>

<script>
  const STORAGE_KEY = 'nomifun-theme';
  const DARK_META = '#0B0A10';
  const LIGHT_META = '#FBF7FA';

  function readTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function applyTheme(theme, persist = true) {
    const nextTheme = theme === 'light' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    document.documentElement.style.colorScheme = nextTheme;
    document.querySelector('meta[data-theme-color]')?.setAttribute('content', nextTheme === 'light' ? LIGHT_META : DARK_META);

    for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
      const isLight = nextTheme === 'light';
      const label = isLight ? button.dataset.labelLight : button.dataset.labelDark;
      if (label) {
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
      button.setAttribute('aria-pressed', String(isLight));
      const icon = button.querySelector('[data-theme-icon]');
      icon?.setAttribute('class', `${isLight ? 'i-mdi-white-balance-sunny' : 'i-mdi-weather-night'} text-lg`);
    }

    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, nextTheme);
      } catch {
        // Ignore private-mode storage failures; the current page still updates.
      }
    }
  }

  applyTheme(readTheme(), false);

  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      applyTheme(readTheme() === 'light' ? 'dark' : 'light');
    });
  }
</script>
