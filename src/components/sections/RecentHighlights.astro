---
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';

const locale: Locale = getLocale(Astro.url);

type Highlight = {
  icon: string;
  title: string;
  body: string;
  tags: string[];
};

type Shot = {
  src: string;
  alt: string;
  label: string;
};

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  release: string;
  proof: string;
  highlights: Highlight[];
  shots: Shot[];
  cta: string;
}> = {
  'zh-CN': {
    eyebrow: '近期迭代 · 2026-07-17',
    title: 'NomiFun 已更新到 <span class="text-grad-pink">v0.2.23</span>',
    lead:
      '最近几个版本把跨平台安装、技能发现、可复用设定、语音输入与整体界面体验补齐。下面只列用户可以直接看到和使用的变化。',
    release: 'v0.2.23',
    proof: '截图来自 v0.2.23 的真实 NomiFun 桌面应用，不是渲染稿。',
    highlights: [
      {
        icon: 'i-simple-icons-linux',
        title: 'Linux 桌面端正式发布',
        body:
          '除 Windows 与 macOS 外，GitHub Releases 现已提供 Linux x86_64 的 AppImage、Debian 与 RPM 安装包，三大桌面平台共享同一套工作台体验。',
        tags: ['AppImage', 'Debian', 'RPM'],
      },
      {
        icon: 'i-mdi-store-search-outline',
        title: '技能市场与技能详情',
        body:
          '技能页新增 Skill Market，可浏览 ClawHub 与 SkillHub 榜单，按搜索和标签筛选、查看详情，再把安装确认交给 Nomi 完成。',
        tags: ['ClawHub', 'SkillHub', '安装前确认'],
      },
      {
        icon: 'i-mdi-tune-variant',
        title: '可复用设定，一键启动',
        body:
          '把 Agent、模型、Skills、知识库与提示要求保存为“设定”，新建会话时一键复用；预置、扩展与自定义设定也有清晰的可编辑边界。',
        tags: ['一键复用', '模型与 Skills', '知识库'],
      },
      {
        icon: 'i-mdi-microphone-outline',
        title: '语音输入与本地 ASR',
        body:
          '会话输入框现在可以直接录音转文字；既可连接云端语音模型，也可安装 Whisper 或中文优化的 FunASR 在本地转写。',
        tags: ['录音转文字', 'Whisper', 'FunASR'],
      },
      {
        icon: 'i-mdi-theme-light-dark',
        title: '工作台界面整体焕新',
        body:
          '默认 Rhythm Dark 主题、重新整理的侧边栏与设置入口、侧边栏更新提示，以及默认使用可见系统浏览器的 Browser Use，让日常操作更直观。',
        tags: ['Rhythm Dark', '更新提示', '可见浏览器'],
      },
    ],
    shots: [
      {
        src: '/screenshots/current-home-zh.png',
        alt: 'NomiFun v0.2.23 主工作台',
        label: '全新工作台',
      },
      {
        src: '/screenshots/skills-market-zh.png',
        alt: 'NomiFun 技能市场',
        label: '技能市场',
      },
      {
        src: '/screenshots/presets-zh.png',
        alt: 'NomiFun 可复用设定',
        label: '设定',
      },
      {
        src: '/screenshots/voice-input-zh.png',
        alt: 'NomiFun 语音输入与本地语音识别设置',
        label: '语音输入',
      },
    ],
    cta: '查看完整文档',
  },
  'en-US': {
    eyebrow: 'Recent updates · 2026-07-17',
    title: 'NomiFun is now at <span class="text-grad-pink">v0.2.23</span>',
    lead:
      'Recent releases complete the cross-platform install story and add skill discovery, reusable presets, speech input, and a refreshed workspace. These are user-facing features you can use today.',
    release: 'v0.2.23',
    proof: 'Screenshots are real captures from NomiFun v0.2.23, not renders.',
    highlights: [
      {
        icon: 'i-simple-icons-linux',
        title: 'Linux desktop packages are live',
        body:
          'Alongside Windows and macOS, GitHub Releases now includes AppImage, Debian, and RPM packages for Linux x86_64, with the same NomiFun workspace across all three desktop platforms.',
        tags: ['AppImage', 'Debian', 'RPM'],
      },
      {
        icon: 'i-mdi-store-search-outline',
        title: 'Skill Market and skill details',
        body:
          'Browse ClawHub and SkillHub rankings, filter by search and tags, inspect skill details, then hand a reviewed installation draft to Nomi.',
        tags: ['ClawHub', 'SkillHub', 'Review before install'],
      },
      {
        icon: 'i-mdi-tune-variant',
        title: 'Reusable presets, one-click setup',
        body:
          'Save an agent, model, Skills, knowledge bases, and prompt requirements as a preset, then reuse the complete setup in one click when starting a conversation.',
        tags: ['One-click reuse', 'Models & Skills', 'Knowledge bases'],
      },
      {
        icon: 'i-mdi-microphone-outline',
        title: 'Speech input and local ASR',
        body:
          'Record directly in the composer for transcription. Use a cloud speech model, or install Whisper or Chinese-optimized FunASR for local recognition.',
        tags: ['Voice to text', 'Whisper', 'FunASR'],
      },
      {
        icon: 'i-mdi-theme-light-dark',
        title: 'A refreshed everyday workspace',
        body:
          'Rhythm Dark is now the default theme, navigation and settings are reorganized, updates appear in the sidebar, and Browser Use opens a visible system browser by default.',
        tags: ['Rhythm Dark', 'Update notice', 'Visible browser'],
      },
    ],
    shots: [
      {
        src: '/screenshots/current-home-en.png',
        alt: 'NomiFun v0.2.23 main workspace',
        label: 'New workspace',
      },
      {
        src: '/screenshots/skills-market-en.png',
        alt: 'NomiFun Skill Market',
        label: 'Skill Market',
      },
      {
        src: '/screenshots/presets-en.png',
        alt: 'NomiFun reusable presets',
        label: 'Presets',
      },
      {
        src: '/screenshots/voice-input-en.png',
        alt: 'NomiFun speech input and local speech recognition settings',
        label: 'Speech input',
      },
    ],
    cta: 'Read the full docs',
  },
};

const t = pick(copy, locale);
const heroShot = t.shots[0];
const supportingShots = t.shots.slice(1);
---

<section id="latest" class="relative section-y bg-ink-850/30">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center">
      <div data-animate>
        <div class="flex flex-wrap items-center gap-3">
          <span class="eyebrow">{t.eyebrow}</span>
          <span class="rounded-full border border-pink-500/35 bg-pink-500/10 px-3 py-1 font-mono text-xs font-semibold text-pink-200">
            {t.release}
          </span>
        </div>

        <h2 class="mt-5 text-3xl font-bold leading-tight text-hi sm:text-4xl lg:text-[2.7rem]">
          <Fragment set:html={t.title} />
        </h2>
        <p class="mt-5 text-base leading-relaxed text-mid sm:text-lg">{t.lead}</p>

        <ul class="mt-8 grid gap-4" data-stagger>
          {
            t.highlights.map((item) => (
              <li class="highlight-row rounded-2xl border border-ink-600/70 bg-ink-900/45 p-4 transition-colors hover:border-pink-500/35 sm:p-5">
                <div class="flex gap-4">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-pink-500/25 bg-pink-500/10">
                    <span class={`${item.icon} text-xl text-pink-400`} aria-hidden="true" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold text-hi">{item.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-mid">{item.body}</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {item.tags.map((tag) => (
                        <span class="rounded-full border border-ink-600 bg-ink-800/70 px-2.5 py-1 font-mono text-[11px] text-low">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>

        <a href={localizePath('/docs', locale)} class="btn-ghost mt-8 text-sm">
          <span class="i-mdi-book-open-page-variant-outline text-base" aria-hidden="true"></span>
          {t.cta}
          <span class="i-mdi-arrow-right text-base" aria-hidden="true"></span>
        </a>
      </div>

      <div data-animate>
        <figure class="overflow-hidden rounded-3xl border border-ink-600 bg-ink-900/70 shadow-[0_0_70px_-26px_rgba(255,111,145,0.58)]">
          <img
            src={heroShot.src}
            alt={heroShot.alt}
            width="1224"
            height="768"
            loading="lazy"
            decoding="async"
            class="block aspect-[16/9] w-full object-cover object-left-top"
          />
          <figcaption class="flex items-center justify-between gap-3 border-t border-ink-700/70 px-4 py-3 text-xs text-low sm:px-5">
            <span class="inline-flex items-center gap-2">
              <span class="i-mdi-camera-outline text-sm text-pink-400" aria-hidden="true"></span>
              {t.proof}
            </span>
            <span class="shrink-0 font-mono text-pink-200">{heroShot.label}</span>
          </figcaption>
        </figure>

        <ul class="mt-4 grid gap-4 sm:grid-cols-3">
          {
            supportingShots.map((shot) => (
              <li class="overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-900/60">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width="1224"
                  height="768"
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[4/3] w-full object-cover object-left-top"
                />
                <p class="border-t border-ink-700/70 px-3 py-2 text-xs font-medium text-mid">{shot.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
