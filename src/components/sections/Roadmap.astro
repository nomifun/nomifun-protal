---
/**
 * Roadmap — a dated, honest view of NomiFun's forward-looking product design.
 *
 * The timeline distinguishes capabilities already developed internally from
 * what is currently public and from work that is still being opened or kept
 * private. It is intentionally not written as a promise that every internal
 * experiment is already released.
 */
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Badge from '@/components/ui/Badge.astro';

const locale: Locale = getLocale(Astro.url);

interface Era {
  date: string;
  label: string;
  title: string;
  body: string;
  icon: string;
  items: string[];
  tone: 'live' | 'ahead' | 'private';
}

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  statusLabels: { live: string; ahead: string; private: string };
  eras: Era[];
  honestTitle: string;
  honestBody: string;
  cta: string;
}> = {
  'zh-CN': {
    eyebrow: '前瞻产品设计 · 2025 — 2026',
    title: '提前布局，但<span class="text-grad-pink">不把内部实验冒充成承诺</span>',
    lead: 'NomiFun 很多能力先在真实工作中自研、验证，再决定何时开放。下面按时间记录已经形成的方向：有些已进入公开版本，有些正在逐步开放，还有一些暂时保密。',
    statusLabels: {
      live: '当前可见',
      ahead: '持续开放',
      private: '内部 / 保密',
    },
    eras: [
      {
        date: '2025',
        label: '内部自研与验证',
        title: '从 Agent 工具，走向可持续工作的系统',
        body: '这一阶段围绕“让 Agent 真正完成工作”建立了多条底层能力线，并在真实项目中反复验证。',
        icon: 'i-mdi-flask-outline',
        tone: 'ahead',
        items: [
          'computer use for xiaozhiAI · browse use for xiaozhiAI',
          '自动化需求管理平台：Loop for Claude / Codex Agent',
          '三方决策、实施分离的 IDMM 智能决策容灾系统',
          '硬件多模态接入伙伴与 Agent 知识库',
          '伙伴记忆、Skill、设定的自进化、迁移与架构',
        ],
      },
      {
        date: '2026 初',
        label: '创新能力逐步上线',
        title: '桌面、移动端、集群与服务一起演进',
        body: 'UI 重构完成后，项目才正式走向开源。新的产品形态开始从单机工作站扩展到移动直连、Agent 集群与客服场景。',
        icon: 'i-mdi-rocket-launch-outline',
        tone: 'ahead',
        items: [
          'Agent Desktop 小程序、普通会话迭代与本地发布工作副本',
          '安全的客服集群系统',
          '手机移动端优先直连 Desktop；可选中继用于跨网络连接',
          '独创的 Agent 集群交互与超级伙伴 IM 网关',
          '更多能力仍在持续验证，部分暂不公开',
        ],
      },
    ],
    honestTitle: '项目为什么现在才公开？',
    honestBody: 'NomiFun 最初只是我们自己使用、再分享给内容朋友的实验性工具。直到 2026 年 UI 重构完成后才开放源码。它仍然是一个人力有限、实验性与公益性并存的项目，我们更希望把代码、边界和真实进度讲清楚，而不是强行营销。',
    cta: '了解如何共建',
  },
  'en-US': {
    eyebrow: 'Forward-looking design · 2025 — 2026',
    title: 'Move early, but <span class="text-grad-pink">never sell internal experiments as promises</span>',
    lead: 'Many NomiFun capabilities were first built and tested in real work before we decided when to open them. This timeline separates what is visible today, what is being opened gradually, and what remains internal or private.',
    statusLabels: {
      live: 'Visible today',
      ahead: 'Opening gradually',
      private: 'Internal / private',
    },
    eras: [
      {
        date: '2025',
        label: 'Internal build & validation',
        title: 'From Agent tools to a system that keeps working',
        body: 'This phase established several foundations for making Agents finish real work, then tested them repeatedly in production-like workflows.',
        icon: 'i-mdi-flask-outline',
        tone: 'ahead',
        items: [
          'computer use for xiaozhiAI · browse use for xiaozhiAI',
          'Automation requirement platform: Loop for Claude / Codex Agent',
          'IDMM disaster-resilient decision system with decision / implementation separation',
          'Hardware multimodal companions and an Agent knowledge base',
          'Self-evolving, portable companion memory, Skills, presets, and architecture',
        ],
      },
      {
        date: 'Early 2026',
        label: 'Innovation rolling into public builds',
        title: 'Desktop, mobile, clusters, and services evolving together',
        body: 'The project only became public after the UI rebuild. New forms now extend the workstation into direct mobile access, Agent clusters, and customer-service scenarios.',
        icon: 'i-mdi-rocket-launch-outline',
        tone: 'ahead',
        items: [
          'Agent Desktop mini apps, normal-session iteration, and local publish working copies',
          'A secure customer-service cluster system',
          'Mobile prefers a direct Desktop connection, with an optional relay for cross-network access',
          'Original Agent-cluster interaction and a super-companion IM gateway',
          'More capabilities remain under validation; some are not public yet',
        ],
      },
    ],
    honestTitle: 'Why is the project only public now?',
    honestBody: 'NomiFun began as an experimental tool for our own work and a few content-creator friends. We opened the source after the 2026 UI rebuild. Bandwidth is still limited, and the project remains both experimental and public-interest oriented, so we would rather explain the code, boundaries, and real progress than push hard marketing.',
    cta: 'See how to contribute',
  },
};

const t = pick(copy, locale);
---

<section id="roadmap" class="relative section-y">
  <div class="container-x">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

    <div class="mt-12 grid gap-6 lg:grid-cols-2" data-stagger>
      {t.eras.map((era) => (
        <article class="card card-hover flex flex-col p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="grid h-12 w-12 place-items-center rounded-2xl border border-pink-500/25 bg-pink-500/10">
                <span class={`${era.icon} text-2xl text-pink-400`} aria-hidden="true"></span>
              </span>
              <div>
                <p class="font-mono text-sm font-semibold text-pink-300">{era.date}</p>
                <p class="mt-0.5 text-xs text-low">{era.label}</p>
              </div>
            </div>
            <Badge tone={era.tone === 'live' ? 'success' : era.tone === 'private' ? 'soon' : 'violet'}>
              <span class={`inline-block h-1.5 w-1.5 rounded-full ${era.tone === 'live' ? 'bg-success' : era.tone === 'private' ? 'bg-warning' : 'bg-violet-300'}`} aria-hidden="true"></span>
              {t.statusLabels[era.tone]}
            </Badge>
          </div>
          <h3 class="mt-6 text-xl font-semibold leading-tight text-hi">{era.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mid">{era.body}</p>
          <ul class="mt-5 flex flex-col gap-3 border-t border-ink-700/70 pt-5">
            {era.items.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-mid">
                <span class="i-mdi-check-circle-outline mt-0.5 shrink-0 text-base text-pink-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-10" data-animate>
      <div class="card relative overflow-hidden p-6 sm:p-8">
        <div class="pointer-events-none absolute -right-16 -top-16 h-44 w-44 rounded-full opacity-50 blur-3xl" style="background: radial-gradient(closest-side, rgba(255,111,145,0.18), transparent)" aria-hidden="true"></div>
        <div class="relative flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-pink-500/30 bg-pink-500/10">
            <span class="i-mdi-hand-heart-outline text-xl text-pink-400" aria-hidden="true"></span>
          </span>
          <div class="min-w-0">
            <h3 class="text-lg font-semibold text-hi">{t.honestTitle}</h3>
            <p class="mt-2 text-base leading-relaxed text-mid">{t.honestBody}</p>
            <a href={localizePath('/contact', locale)} class="btn-ghost mt-5 text-sm">
              <span class="i-mdi-account-group-outline text-base" aria-hidden="true"></span>
              {t.cta}
              <span class="i-mdi-arrow-right text-base" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
