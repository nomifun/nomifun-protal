---
/**
 * Roadmap — a dated, honest view of NomiFun's delivered product work.
 *
 * The timeline distinguishes internal production use from public release and
 * from unreleased confidential work. Shipped work is not described as a future
 * promise, while confidential details remain deliberately bounded.
 */
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Badge from '@/components/ui/Badge.astro';

const locale: Locale = getLocale(Astro.url);

interface Era {
  date: string;
  label: string;
  title: string;
  body: string;
  icon: string;
  items: string[];
  tone: 'live' | 'ahead' | 'private';
}

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  statusLabels: { live: string; ahead: string; private: string };
  eras: Era[];
  honestTitle: string;
  honestBody: string;
  cta: string;
}> = {
  'zh-CN': {
    eyebrow: '已实现的产品创新 · 2025 — 2026',
    title: '从内部投入使用，到<span class="text-grad-pink">创新能力正式上线</span>',
    lead: '这不是未来功能愿望单。2025 年列出的能力已经由团队自研并投入内部真实工作；2026 年初列出的创新已经上线。开源范围、公开入口与内部投用范围可能不同，尚未推出的保密能力会明确单列。',
    statusLabels: {
      live: '已实现 / 已上线',
      ahead: '持续开放',
      private: '内部 / 保密',
    },
    eras: [
      {
        date: '2025',
        label: '内部已实现并投入使用',
        title: '把 Agent 从单点工具升级为可持续工作的系统',
        body: '以下六条能力在 2025 年已经完成内部实现，并在真实项目和日常工作中投入使用；它们不是尚待兑现的前瞻概念。',
        icon: 'i-mdi-check-decagram-outline',
        tone: 'live',
        items: [
          '面向 XiaozhiAI 的 Computer Use 与 Browser Use',
          '自动化需求管理平台：Loop for Claude、Codex Agent',
          '三方决策、实施分离的 Agent 系统与智能决策容灾系统',
          '硬件多模态接入伙伴',
          '面向 Agent CoT Work 的知识库',
          '伙伴的记忆、Skill 与设定自进化、迁移及架构体系',
        ],
      },
      {
        date: '2026 初',
        label: '创新能力已经上线',
        title: '桌面、移动端、集群与服务一起演进',
        body: '2026 年初，NomiFun 已从单机工作站扩展到小程序、移动直连、Agent 集群、客服系统与 IM Channel 网关；这些条目描述已上线能力，不再标记为“逐步开放”的未来方向。',
        icon: 'i-mdi-rocket-launch-outline',
        tone: 'live',
        items: [
          'Agent Desktop 小程序',
          '安全的客服集群系统',
          '手机移动端直连 Desktop：当前不依赖 NomiFun 云端服务器中转',
          '独创的 Agent 集群交互',
          '超级桌面伙伴 Agent IM Channel 网关',
          '另有多项处于保密阶段、尚未推出的能力；未发布细节暂不对外披露',
        ],
      },
    ],
    honestTitle: '项目为什么现在才公开？',
    honestBody: 'NomiFun 最初只是我们自己使用、再分享给内容朋友的实验性工具。直到 2026 年 UI 重构完成后才开放源码。它仍然是一个人力有限、实验性与公益性并存的项目，我们更希望把代码、边界和真实进度讲清楚，而不是强行营销。',
    cta: '了解如何共建',
  },
  'en-US': {
    eyebrow: 'Delivered product innovation · 2025 — 2026',
    title: 'From internal production use to <span class="text-grad-pink">innovation shipped in product</span>',
    lead: 'This is not a future-feature wish list. The 2025 capabilities were built in-house and put into real internal use; the early-2026 innovations have shipped. Open-source scope, public entry points, and internal deployment can differ, while unreleased confidential work is explicitly identified.',
    statusLabels: {
      live: 'Built / shipped',
      ahead: 'Opening gradually',
      private: 'Internal / private',
    },
    eras: [
      {
        date: '2025',
        label: 'Built and in internal production use',
        title: 'Turning Agents from isolated tools into a system that keeps working',
        body: 'These six capabilities were implemented in 2025 and used in real projects and daily internal work. They are delivered systems, not forward-looking concepts awaiting implementation.',
        icon: 'i-mdi-check-decagram-outline',
        tone: 'live',
        items: [
          'Computer Use and Browser Use for XiaozhiAI',
          'Automated requirement-management platform: Loop for Claude and Codex Agent',
          'A three-party Agent system separating decisions from implementation, with intelligent decision failover',
          'Hardware multimodal companion integration',
          'A knowledge base for Agent CoT work',
          'Self-evolving and portable companion memory, Skills, presets, and architecture',
        ],
      },
      {
        date: 'Early 2026',
        label: 'Product innovations shipped',
        title: 'Desktop, mobile, clusters, and services evolving together',
        body: 'By early 2026, NomiFun had expanded beyond a standalone workstation into mini apps, direct mobile access, Agent clusters, customer service, and an IM Channel gateway. These entries describe shipped capabilities, not a gradual future rollout.',
        icon: 'i-mdi-rocket-launch-outline',
        tone: 'live',
        items: [
          'Agent Desktop mini apps',
          'A secure customer-service cluster system',
          'Mobile connects directly to Desktop without a NomiFun cloud application server relaying current traffic',
          'Original Agent-cluster interaction',
          'Super desktop companion Agent IM Channel gateway',
          'Additional capabilities remain confidential and unreleased; details are intentionally not disclosed',
        ],
      },
    ],
    honestTitle: 'Why is the project only public now?',
    honestBody: 'NomiFun began as an experimental tool for our own work and a few content-creator friends. We opened the source after the 2026 UI rebuild. Bandwidth is still limited, and the project remains both experimental and public-interest oriented, so we would rather explain the code, boundaries, and real progress than push hard marketing.',
    cta: 'See how to contribute',
  },
};

const t = pick(copy, locale);
---

<section id="roadmap" class="relative section-y">
  <div class="container-x">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

    <div class="mt-12 grid gap-6 lg:grid-cols-2" data-stagger>
      {t.eras.map((era) => (
        <article class="card card-hover flex flex-col p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="grid h-12 w-12 place-items-center rounded-2xl border border-pink-500/25 bg-pink-500/10">
                <span class={`${era.icon} text-2xl text-pink-400`} aria-hidden="true"></span>
              </span>
              <div>
                <p class="font-mono text-sm font-semibold text-pink-300">{era.date}</p>
                <p class="mt-0.5 text-xs text-low">{era.label}</p>
              </div>
            </div>
            <Badge tone={era.tone === 'live' ? 'success' : era.tone === 'private' ? 'soon' : 'violet'}>
              <span class={`inline-block h-1.5 w-1.5 rounded-full ${era.tone === 'live' ? 'bg-success' : era.tone === 'private' ? 'bg-warning' : 'bg-violet-300'}`} aria-hidden="true"></span>
              {t.statusLabels[era.tone]}
            </Badge>
          </div>
          <h3 class="mt-6 text-xl font-semibold leading-tight text-hi">{era.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mid">{era.body}</p>
          <ul class="mt-5 flex flex-col gap-3 border-t border-ink-700/70 pt-5">
            {era.items.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-mid">
                <span class="i-mdi-check-circle-outline mt-0.5 shrink-0 text-base text-pink-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-10" data-animate>
      <div class="card relative overflow-hidden p-6 sm:p-8">
        <div class="pointer-events-none absolute -right-16 -top-16 h-44 w-44 rounded-full opacity-50 blur-3xl" style="background: radial-gradient(closest-side, rgba(255,111,145,0.18), transparent)" aria-hidden="true"></div>
        <div class="relative flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-pink-500/30 bg-pink-500/10">
            <span class="i-mdi-hand-heart-outline text-xl text-pink-400" aria-hidden="true"></span>
          </span>
          <div class="min-w-0">
            <h3 class="text-lg font-semibold text-hi">{t.honestTitle}</h3>
            <p class="mt-2 text-base leading-relaxed text-mid">{t.honestBody}</p>
            <a href={localizePath('/contact', locale)} class="btn-ghost mt-5 text-sm">
              <span class="i-mdi-account-group-outline text-base" aria-hidden="true"></span>
              {t.cta}
              <span class="i-mdi-arrow-right text-base" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
