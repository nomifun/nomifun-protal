---
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';
import { links } from '@/data/links';

const locale: Locale = getLocale(Astro.url);

const copy: Dict<{
  eyebrow: string;
  titleA: string;
  titleHi: string;
  lead: string;
  ctaProducts: string;
  ctaSource: string;
  desktopAlt: string;
  mobileAlt: string;
  badges: string[];
}> = {
  'zh-CN': {
    eyebrow: '三个产品 · 一套本地优先的开源 AI 生态',
    titleA: '从电脑到手机，再到机器人',
    titleHi: 'NomiFun 全部开放源码',
    lead:
      'Desktop 是本地 AI 工作站与服务中枢，Mobile 把会话、任务、需求和伙伴带到手机，小智云台让 AI 获得真实世界的视角与动作。三个项目可以独立使用，也能组合成完整体验。',
    ctaProducts: '认识三个产品',
    ctaSource: '查看开源项目',
    desktopAlt: '最新版 NomiFun Desktop 工作台',
    mobileAlt: '已连接 Desktop 的 NomiFun Mobile',
    badges: ['Desktop · 本地 AI 中枢', 'Mobile · 随身遥控器', '小智云台 · 机器人载体'],
  },
  'en-US': {
    eyebrow: 'Three products · one local-first open-source AI ecosystem',
    titleA: 'From desktop to phone to robot',
    titleHi: 'every NomiFun product is open source',
    lead:
      'Desktop is the local AI workstation and service hub. Mobile brings sessions, tasks, requirements, and companions to your phone. Xiaozhi Yuntai gives AI a view of — and a way to move through — the physical world. Use each project alone or connect all three.',
    ctaProducts: 'Explore the products',
    ctaSource: 'Browse the source',
    desktopAlt: 'Latest NomiFun Desktop workspace',
    mobileAlt: 'NomiFun Mobile connected to Desktop',
    badges: ['Desktop · local AI hub', 'Mobile · pocket remote', 'Xiaozhi · robot platform'],
  },
};

const t = pick(copy, locale);
const desktopImage =
  locale === 'zh-CN'
    ? '/screenshots/desktop/desktop-home-zh.png'
    : '/screenshots/desktop/desktop-home-en.png';
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-mesh"></div>
  <div
    class="pointer-events-none absolute left-1/2 top-[-8%] -z-10 h-[620px] w-[980px] -translate-x-1/2 rounded-full opacity-70 blur-3xl"
    style="background: radial-gradient(closest-side, rgba(255,111,145,0.2), transparent)"
  ></div>

  <div class="container-x grid items-center gap-14 pb-20 pt-24 sm:pt-32 lg:grid-cols-[0.9fr_1.1fr] lg:pb-28 lg:pt-36">
    <div class="text-center lg:text-left">
      <span class="eyebrow" data-animate>{t.eyebrow}</span>
      <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl" data-animate>
        <span class="text-hi">{t.titleA}</span>
        <span class="mt-3 block text-grad-pink">{t.titleHi}</span>
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-mid sm:text-lg lg:mx-0" data-animate>
        {t.lead}
      </p>
      <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row lg:justify-start" data-animate>
        <a href={localizePath('/products', locale)} class="btn-primary px-7 py-3.5 text-base">
          <span class="i-mdi-view-grid-outline text-lg"></span>{t.ctaProducts}
        </a>
        <a href={links.desktopRepo} target="_blank" rel="noopener" class="btn-ghost px-7 py-3.5 text-base">
          <span class="i-mdi-github text-lg"></span>{t.ctaSource}
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start" data-stagger>
        {t.badges.map((badge) => (
          <li class="rounded-full border border-ink-600/80 bg-ink-800/55 px-3 py-1.5 text-xs font-medium text-mid">
            {badge}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-3xl" data-animate>
      <div
        class="pointer-events-none absolute -inset-8 -z-10 rounded-[3rem] opacity-60 blur-3xl"
        style="background: radial-gradient(closest-side, rgba(255,111,145,0.2), transparent)"
      ></div>
      <figure class="overflow-hidden rounded-2xl border border-ink-600 bg-ink-850 shadow-[0_30px_100px_-45px_rgba(255,111,145,0.7)]">
        <img src={desktopImage} alt={t.desktopAlt} width="1648" height="980" class="block h-auto w-full" />
      </figure>
      <figure class="absolute -bottom-9 right-3 w-[30%] min-w-[118px] max-w-[190px] overflow-hidden rounded-[1.4rem] border-[5px] border-ink-900 bg-white shadow-2xl sm:-bottom-12 sm:right-8">
        <img
          src="/screenshots/mobile/mobile-profile-zh.png"
          alt={t.mobileAlt}
          width="390"
          height="844"
          class="block h-auto w-full"
        />
      </figure>
      <div class="absolute -left-3 -top-5 inline-flex items-center gap-2 rounded-full border border-ink-600 bg-ink-900/90 px-3 py-2 text-xs font-semibold text-hi shadow-xl backdrop-blur sm:left-4">
        <span class="i-mdi-open-source-initiative text-lg text-pink-400"></span>
        Apache-2.0
      </div>
    </div>
  </div>
</section>
