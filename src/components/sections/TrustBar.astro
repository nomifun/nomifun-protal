---
import { getLocale, pick, type Dict, type Locale } from '@/i18n';

const locale: Locale = getLocale(Astro.url);

const copy: Dict<{ items: { icon: string; label: string }[] }> = {
  'zh-CN': {
    items: [
      { icon: 'i-mdi-shield-lock-outline', label: '数据全在本地' },
      { icon: 'i-mdi-source-branch', label: 'Apache-2.0 完全开源' },
      { icon: 'i-mdi-cash-remove', label: '免费商用 · 无广告无会员' },
      { icon: 'i-mdi-magnify-scan', label: '源码公开 · 接受审计' },
    ],
  },
  'en-US': {
    items: [
      { icon: 'i-mdi-shield-lock-outline', label: 'All data stays local' },
      { icon: 'i-mdi-source-branch', label: 'Apache-2.0 open source' },
      { icon: 'i-mdi-cash-remove', label: 'Free commercial use · no ads' },
      { icon: 'i-mdi-magnify-scan', label: 'Open source · open to audit' },
    ],
  },
};

const t = pick(copy, locale);
---

<div class="border-y border-ink-700/70 bg-ink-850/40">
  <div class="container-x">
    <ul class="grid grid-cols-2 gap-px md:grid-cols-4" data-stagger>
      {t.items.map((it) => (
        <li class="flex items-center justify-center gap-2.5 px-4 py-5 text-center">
          <span class={`${it.icon} text-xl text-pink-400`}></span>
          <span class="text-sm font-medium text-mid">{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
