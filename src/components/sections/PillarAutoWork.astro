---
/**
 * PillarAutoWork — pillar 3: 智能值守（需求平台 + AutoWork + IDMM）.
 *
 * Accuracy red lines (spec §2/§3):
 *  - 需求看板按 tag 智能轮转、单循环执行
 *  - 租约清扫 60s 重派孤儿任务 + 开机自动恢复 → 高可靠保活、无人值守
 *  - 完成通知 OUTBOUND 推送 → Lark / Slack / HTTP webhook
 *  - IDMM = 每会话监督层：规则层（重试/退避/推动/只读权限自动确认）
 *    + 旁路模型层（真正决策卡点），可触发模型 failover 队列
 *  - issue / IM 入站转需求 = 敬请期待（ROADMAP，绝不宣称已实现）
 */
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';
import Badge from '@/components/ui/Badge.astro';
import AutoWorkBoard from '@/components/islands/AutoWorkBoard.tsx';

const locale: Locale = getLocale(Astro.url);

interface Point {
  icon: string;
  title: string;
  body: string;
}

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  points: Point[];
  soon: string;
  ctaSecondary: string;
  punch: string;
}> = {
  'zh-CN': {
    eyebrow: '智能值守 · 你只管指挥',
    title: '需求平台 + AutoWork + IDMM，<span class="text-grad-pink">把活儿可靠地跑完</span>',
    lead: '把需求丢进看板，剩下的交给它：按 tag 智能轮转、单循环执行，租约清扫与开机自恢复保证高可靠保活——你只管指挥，它会可靠地为你工作。',
    points: [
      {
        icon: 'i-mdi-view-column-outline',
        title: '需求看板 · 智能轮转',
        body: 'Pending→InProgress→Done/Failed/NeedsReview，按 tag 智能轮转、单循环执行，后端是唯一事实源。',
      },
      {
        icon: 'i-mdi-restart-alert',
        title: '高可靠保活 · 无人值守',
        body: '租约清扫每 60s 重派孤儿任务，进程重启后开机自动恢复——长时间无人值守也不掉链子。',
      },
      {
        icon: 'i-mdi-shield-sync-outline',
        title: 'IDMM 智能决策 · 全程护航',
        body: '规则层自动重试 / 退避 / 推动 / 只读权限自动确认；旁路模型层处理真正的决策卡点，可触发模型故障 failover 队列。',
      },
    ],
    soon: 'issue / IM 入站转需求 敬请期待',
    ctaSecondary: '查看值守与 IDMM 文档',
    punch: '你只管指挥，它会可靠地为你工作。',
  },
  'en-US': {
    eyebrow: 'Unattended · you just direct',
    title: 'Requirement board + AutoWork + IDMM, <span class="text-grad-pink">work that finishes itself</span>',
    lead: 'Drop a requirement on the board and it takes over: smart per-tag rotation, single-loop execution, with lease sweeping and boot resume keeping it reliably alive — you just direct, it works for you.',
    points: [
      {
        icon: 'i-mdi-view-column-outline',
        title: 'Requirement board · smart rotation',
        body: 'Pending→InProgress→Done/Failed/NeedsReview, rotated per tag with single-loop execution. The backend is the single source of truth.',
      },
      {
        icon: 'i-mdi-restart-alert',
        title: 'High-reliability keep-alive · unattended',
        body: 'A lease sweeper re-pends orphaned tasks every 60s, and boot resume picks work back up after a restart — dependable even when no one is watching.',
      },
      {
        icon: 'i-mdi-shield-sync-outline',
        title: 'IDMM supervision · end to end',
        body: 'Rule tier auto-retries / backs off / nudges / auto-confirms read-only permissions; the sidecar model tier handles genuine decision stalls and can trigger a model failover queue.',
      },
    ],
    soon: 'issue / IM inbound → requirement, coming soon',
    ctaSecondary: 'Read the watch & IDMM docs',
    punch: 'You just direct — it works for you, reliably.',
  },
};

const t = pick(copy, locale);

const webhooks = ['Lark', 'Slack', 'HTTP webhook'];
const webhookLabel = locale === 'zh-CN' ? '完成通知推送' : 'Completion notifications';
---

<section id="autowork" class="relative section-y">
  <div class="container-x">
    <div class="flex flex-col gap-4 max-w-3xl" data-animate>
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold leading-tight tracking-tight text-hi">
        <Fragment set:html={t.title} />
      </h2>
      <p class="text-base sm:text-lg text-mid leading-relaxed">{t.lead}</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-start lg:gap-12">
      <!-- Capability points + outbound webhooks + roadmap note + CTA -->
      <div class="flex flex-col gap-5">
        <ul class="flex flex-col gap-4" data-stagger>
          {t.points.map((p) => (
            <li class="card card-hover flex gap-4 p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-pink-500/25 bg-pink-500/10">
                <span class={`${p.icon} text-xl text-pink-400`} aria-hidden="true"></span>
              </span>
              <div class="min-w-0">
                <h3 class="text-base font-semibold text-hi">{p.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-mid">{p.body}</p>
              </div>
            </li>
          ))}
        </ul>

        <!-- Outbound completion webhooks (NOT inbound) -->
        <div class="rounded-2xl border border-ink-600/70 bg-ink-850/50 p-4" data-animate>
          <div class="flex items-center gap-2">
            <span class="i-mdi-webhook text-lg text-violet-300" aria-hidden="true"></span>
            <span class="text-sm font-semibold text-hi">{webhookLabel}</span>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {webhooks.map((w) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-ink-600 bg-ink-800/70 px-3 py-1 text-xs font-medium text-mid">
                <span class="i-mdi-arrow-top-right-thin text-sm text-success" aria-hidden="true"></span>{w}
              </span>
            ))}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-1" data-animate>
          <Badge tone="soon">
            <span class="i-mdi-clock-outline text-sm" aria-hidden="true"></span>{t.soon}
          </Badge>
          <a href={localizePath('/docs', locale)} class="btn-ghost text-sm">
            {t.ctaSecondary}
            <span class="i-mdi-arrow-right text-base" aria-hidden="true"></span>
          </a>
        </div>
      </div>

      <!-- Interactive board -->
      <div class="lg:sticky lg:top-24" data-animate>
        <AutoWorkBoard locale={locale} client:visible />
        <p class="mt-4 text-center text-sm font-medium text-mid">
          <span class="text-grad-pink">{t.punch}</span>
        </p>
      </div>
    </div>
  </div>
</section>
