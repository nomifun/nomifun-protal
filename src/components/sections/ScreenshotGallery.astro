---
import { getLocale, localizePath, pick, type Dict, type Locale } from '@/i18n';

const locale: Locale = getLocale(Astro.url);

const copy: Dict<{
  eyebrow: string;
  title: string;
  lead: string;
  badge: string;
  view: string;
  captions: string[];
}> = {
  'zh-CN': {
    eyebrow: '2026 最新实拍',
    title: 'Desktop 与 Mobile 的真实运行界面',
    lead: '本页旧截图已由本机最新版 Desktop 与实际连接 Desktop 的 Mobile 重新拍摄。点击任一画面进入对应产品介绍。',
    badge: '本次新截图',
    view: '产品介绍',
    captions: ['Desktop 工作台', 'Desktop 模型管理', 'Desktop 桌面伙伴', 'Desktop 技能中心', 'Mobile 会话与项目', 'Mobile 已连接状态'],
  },
  'en-US': {
    eyebrow: 'Latest 2026 captures',
    title: 'The real running Desktop and Mobile UI',
    lead: 'The old site captures have been replaced with new screenshots from the installed Desktop and a Mobile client actually connected to it.',
    badge: 'New capture',
    view: 'Product guide',
    captions: ['Desktop workspace', 'Desktop model management', 'Desktop companion', 'Desktop Skills center', 'Mobile sessions and projects', 'Mobile connected state'],
  },
};

const t = pick(copy, locale);
const desktopSuffix = locale === 'zh-CN' ? 'zh' : 'en';
const shots = [
  { src: '/screenshots/desktop/desktop-home-' + desktopSuffix + '.png', href: '/products/desktop', caption: t.captions[0], kind: 'desktop' },
  { src: '/screenshots/desktop/desktop-models-' + desktopSuffix + '.png', href: '/products/desktop', caption: t.captions[1], kind: 'desktop' },
  { src: '/screenshots/desktop/desktop-companion-' + desktopSuffix + '.png', href: '/products/desktop', caption: t.captions[2], kind: 'desktop' },
  { src: '/screenshots/desktop/desktop-skills-' + desktopSuffix + '.png', href: '/products/desktop', caption: t.captions[3], kind: 'desktop' },
  { src: '/screenshots/mobile/mobile-sessions-zh.png', href: '/products/mobile', caption: t.captions[4], kind: 'mobile' },
  { src: '/screenshots/mobile/mobile-profile-zh.png', href: '/products/mobile', caption: t.captions[5], kind: 'mobile' },
];
---

<section id="screenshots" class="relative section-y">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center" data-animate>
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="mt-5 text-3xl font-bold tracking-tight text-hi sm:text-4xl">{t.title}</h2>
      <p class="mt-4 text-base leading-relaxed text-mid sm:text-lg">{t.lead}</p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {shots.map((shot) => (
        <li class:list={['min-w-0', shot.kind === 'mobile' ? 'flex justify-center' : '']}>
          <a
            href={localizePath(shot.href, locale)}
            class:list={[
              'group block overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-800/60 transition hover:border-pink-500/45',
              shot.kind === 'mobile' ? 'w-full max-w-[260px]' : 'w-full',
            ]}
          >
            <span class="relative block overflow-hidden bg-ink-950">
              <img
                src={shot.src}
                alt={shot.caption}
                width={shot.kind === 'mobile' ? 390 : 1648}
                height={shot.kind === 'mobile' ? 844 : 980}
                loading="lazy"
                decoding="async"
                class:list={[
                  'block w-full transition duration-500 group-hover:scale-[1.025]',
                  shot.kind === 'mobile' ? 'aspect-[390/844] object-contain' : 'aspect-[16/10] object-cover object-top',
                ]}
              />
              <span class="absolute right-2.5 top-2.5 rounded-full border border-white/10 bg-ink-950/80 px-2 py-1 text-[10px] font-medium text-pink-300 backdrop-blur">
                {t.badge}
              </span>
            </span>
            <span class="flex items-center justify-between gap-3 px-4 py-3.5">
              <span class="truncate text-sm text-mid group-hover:text-hi">{shot.caption}</span>
              <span class="shrink-0 text-xs font-medium text-low group-hover:text-pink-300">{t.view}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
