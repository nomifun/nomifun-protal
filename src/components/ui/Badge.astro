---
/**
 * Badge — small pill. Tones: pink (default), violet, neutral, soon (roadmap).
 */
interface Props {
  tone?: 'pink' | 'violet' | 'neutral' | 'soon' | 'success';
  class?: string;
}
const { tone = 'pink', class: className = '' } = Astro.props;
const tones: Record<string, string> = {
  pink: 'border-pink-500/30 bg-pink-500/10 text-pink-300',
  violet: 'border-violet-400/30 bg-violet-500/10 text-violet-300',
  neutral: 'border-ink-600 bg-ink-700/60 text-mid',
  soon: 'border-warning/30 bg-warning/10 text-warning',
  success: 'border-success/30 bg-success/10 text-success',
};
---

<span class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium ${tones[tone]} ${className}`}>
  <slot />
</span>
