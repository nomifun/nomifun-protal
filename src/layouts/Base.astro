---
import '@unocss/reset/tailwind.css';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { getLocale, htmlLang, delocalizePath, localizePath, type Locale } from '@/i18n';
import { links, socialLinks, meta } from '@/data/links';
import { activeVerifications } from '@/data/siteVerification';

interface Props {
  title?: string;
  description?: string;
  /** disable the default header/footer chrome (rarely needed) */
  bare?: boolean;
  /** emit SoftwareApplication JSON-LD (home & download pages only) */
  softwareApp?: boolean;
}

const locale: Locale = getLocale(Astro.url);
const lang = htmlLang[locale];

const defaults = {
  'zh-CN': {
    title: 'NomiFun · 完全开源的超级 AI 工作站',
    description:
      'NomiFun 是一项完全开源、本地优先的超级 AI 工作站。数据全在本地，免费商用，超级伙伴养成、智能值守、开放生态、统一搭配、原生 computer/browser use，满足你对 AI 工作站的想象。',
  },
  'en-US': {
    title: 'NomiFun · Fully open-source super AI workstation',
    description:
      'NomiFun is a fully open-source, local-first super AI workstation. All data stays local, free for commercial use — evolving companions, unattended automation, an open capability ecosystem, unified config, and native computer/browser use.',
  },
};

const { title = defaults[locale].title, description = defaults[locale].description, bare = false, softwareApp = false } = Astro.props;

// Normalize to trailing-slash form so canonical, hreflang, and the sitemap all
// reference the exact same URL string (the sitemap emits trailing slashes).
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const canonical = new URL(norm(Astro.url.pathname), Astro.site).toString();

// Reciprocal language alternates, always pointing at the canonical root for each
// locale (en at "/", zh at "/zh/…") regardless of which page renders this layout.
const basePath = delocalizePath(Astro.url.pathname);
const enHref = new URL(norm(localizePath(basePath, 'en-US')), Astro.site).toString();
const zhHref = new URL(norm(localizePath(basePath, 'zh-CN')), Astro.site).toString();

const ogImage = new URL('/brand/og-cover.png', Astro.site).toString();
const ogImageAlt =
  locale === 'zh-CN'
    ? 'NomiFun — 完全开源的超级 AI 工作站'
    : 'NomiFun — fully open-source super AI workstation';
const twitterHandle = '@' + socialLinks.x.split('/').pop();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NomiFun',
  url: 'https://www.nomifun.com/',
  logo: 'https://www.nomifun.com/brand/logo.svg',
  sameAs: [
    links.github,
    socialLinks.x,
    socialLinks.youtube,
    socialLinks.tiktok,
    socialLinks.bilibili,
    socialLinks.douyin,
    socialLinks.xiaohongshu,
  ],
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NomiFun',
  url: 'https://www.nomifun.com/',
  inLanguage: ['en', 'zh-CN'],
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NomiFun',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  url: 'https://www.nomifun.com/',
  downloadUrl: links.releases,
  softwareVersion: meta.version,
  license: links.license,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: defaults['en-US'].description,
};
const jsonLd = softwareApp ? [orgLd, siteLd, appLd] : [orgLd, siteLd];
---

<!doctype html>
<html lang={lang} class="scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0A10" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Search-engine ownership verification (Google / Bing / Baidu / Yandex) -->
    {activeVerifications.map((v) => <meta name={v.name} content={v.content} />)}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NomiFun" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <JsonLd schema={jsonLd} />
  </head>
  <body>
    {!bare && <Header />}
    <main class={bare ? '' : 'pt-16'}>
      <slot />
    </main>
    {!bare && <Footer />}

    <script>
      // Reveal-on-scroll: add `.in-view` to [data-animate]/[data-stagger] elements.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-animate], [data-stagger]');
      if (prefersReduced) {
        targets.forEach((el) => el.classList.add('in-view'));
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('in-view'));
      }
    </script>
  </body>
</html>
