---
import Base from '@/layouts/Base.astro';
import DocsSidebar from '@/components/docs/DocsSidebar.astro';
import { getLocale, type Locale } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  /** active topic slug for sidebar highlight (empty on index) */
  activeSlug?: string;
  /** page H1 — when set, rendered above the slot inside the prose column */
  heading?: string;
  /** small label above the heading (e.g. the category) */
  eyebrow?: string;
}

const { title, description, activeSlug = '', heading, eyebrow } = Astro.props;
const locale: Locale = getLocale(Astro.url);
const toc = locale === 'zh-CN' ? '目录' : 'Contents';
const seoTitle = title ? `${title} · NomiFun ${locale === 'zh-CN' ? '文档' : 'Docs'}` : undefined;
---

<Base title={seoTitle} description={description}>
  <div class="container-x py-10 sm:py-14">
    <!-- mobile sidebar toggle -->
    <button
      id="docs-nav-toggle"
      class="lg:hidden mb-6 inline-flex items-center gap-2 rounded-lg border border-ink-600 px-4 py-2 text-sm font-medium text-mid hover:text-hi hover:border-violet-400/60 transition-colors"
      aria-controls="docs-nav-drawer"
      aria-expanded="false"
    >
      <span class="i-mdi-menu text-base"></span>
      {toc}
    </button>

    <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)] xl:gap-14">
      <!-- desktop sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2 docs-scroll">
          <DocsSidebar activeSlug={activeSlug} />
        </div>
      </aside>

      <!-- content -->
      <article class="min-w-0">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {heading && (
          <h1 class="mt-3 mb-8 text-3xl sm:text-4xl font-bold tracking-tight text-hi leading-tight">
            {heading}
          </h1>
        )}
        <div class="docs-prose">
          <slot />
        </div>
        <!-- non-prose content (card grids, prev/next nav) lives outside .docs-prose -->
        <slot name="after" />
      </article>
    </div>
  </div>

  <!-- mobile drawer -->
  <div
    id="docs-nav-overlay"
    class="lg:hidden fixed inset-0 z-50 hidden bg-ink-950/70 backdrop-blur-sm"
  >
    <div
      id="docs-nav-drawer"
      class="absolute left-0 top-0 h-full w-[19rem] max-w-[85vw] translate-x-[-100%] overflow-y-auto border-r border-ink-700 bg-ink-900 p-6 shadow-2xl transition-transform duration-300 docs-scroll"
    >
      <DocsSidebar activeSlug={activeSlug} id="docs-nav-mobile" />
    </div>
  </div>
</Base>

<script>
  const toggle = document.getElementById('docs-nav-toggle');
  const overlay = document.getElementById('docs-nav-overlay');
  const drawer = document.getElementById('docs-nav-drawer');

  function open() {
    overlay?.classList.remove('hidden');
    requestAnimationFrame(() => drawer?.classList.remove('translate-x-[-100%]'));
    toggle?.setAttribute('aria-expanded', 'true');
  }
  function close() {
    drawer?.classList.add('translate-x-[-100%]');
    toggle?.setAttribute('aria-expanded', 'false');
    window.setTimeout(() => overlay?.classList.add('hidden'), 300);
  }

  toggle?.addEventListener('click', open);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });
  // close after picking a destination
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay?.classList.contains('hidden')) close();
  });
</script>

<style>
  /* Slim scrollbar for the sticky sidebar / drawer */
  .docs-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink-600, #322e3c) transparent;
  }
  .docs-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .docs-scroll::-webkit-scrollbar-thumb {
    background: #322e3c;
    border-radius: 9999px;
  }

  /* ---- Prose: polished dark-theme markdown ---- */
  .docs-prose {
    color: #b8b3c4; /* text-mid */
    font-size: 1rem;
    line-height: 1.75;
    max-width: 46rem;
  }
  .docs-prose > :first-child {
    margin-top: 0;
  }

  .docs-prose :global(h1),
  .docs-prose :global(h2),
  .docs-prose :global(h3),
  .docs-prose :global(h4) {
    color: #f5f3f7; /* text-hi */
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    scroll-margin-top: 6rem;
  }
  .docs-prose :global(h2) {
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    font-size: 1.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(50, 46, 60, 0.7);
  }
  .docs-prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  .docs-prose :global(h4) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }

  .docs-prose :global(p) {
    margin: 1.1rem 0;
  }
  .docs-prose :global(strong) {
    color: #f5f3f7;
    font-weight: 600;
  }

  .docs-prose :global(a) {
    color: #ffb3c4; /* pink-300 */
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 159, 180, 0.35);
    transition: color 0.15s, border-color 0.15s;
  }
  .docs-prose :global(a:hover) {
    color: #ff6f91; /* pink-500 */
    border-bottom-color: #ff6f91;
  }

  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    margin: 1.1rem 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .docs-prose :global(ul) {
    list-style: none;
  }
  .docs-prose :global(ul > li) {
    position: relative;
    padding-left: 1.1rem;
  }
  .docs-prose :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #ff9fb4, #ff6f91);
  }
  .docs-prose :global(ol) {
    list-style: decimal;
  }
  .docs-prose :global(ol > li)::marker {
    color: #ff9fb4;
    font-weight: 600;
  }
  .docs-prose :global(li > ul),
  .docs-prose :global(li > ol) {
    margin: 0.45rem 0 0;
  }

  /* inline code */
  .docs-prose :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    color: #ffb3c4;
    background: rgba(255, 111, 145, 0.1);
    border: 1px solid rgba(255, 111, 145, 0.18);
    border-radius: 6px;
    padding: 0.1em 0.4em;
  }
  /* fenced code blocks */
  .docs-prose :global(pre) {
    margin: 1.5rem 0;
    padding: 1.1rem 1.25rem;
    background: #07060b; /* ink-950 */
    border: 1px solid rgba(50, 46, 60, 0.8);
    border-radius: 14px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .docs-prose :global(pre code) {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #d7d3df;
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  .docs-prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.8rem 1.1rem;
    border-left: 3px solid #ff6f91;
    border-radius: 0 12px 12px 0;
    background: rgba(255, 111, 145, 0.06);
    color: #b8b3c4;
  }
  .docs-prose :global(blockquote p) {
    margin: 0.3rem 0;
  }

  .docs-prose :global(img) {
    margin: 1.75rem 0;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid rgba(50, 46, 60, 0.8);
    box-shadow: 0 0 40px -16px rgba(255, 111, 145, 0.25);
  }

  .docs-prose :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid rgba(50, 46, 60, 0.7);
  }

  .docs-prose :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .docs-prose :global(th),
  .docs-prose :global(td) {
    border: 1px solid rgba(50, 46, 60, 0.8);
    padding: 0.55rem 0.8rem;
    text-align: left;
  }
  .docs-prose :global(th) {
    background: rgba(27, 24, 34, 0.7);
    color: #f5f3f7;
    font-weight: 600;
  }
</style>
